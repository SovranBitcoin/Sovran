{
  "name": "@sovranbitcoin/nagg-ts",
  "version": "0.7.0",
  "description": "Typed, UI-agnostic client helpers for generic Nagg GraphQL and app-view APIs.",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./map": "./src/map/index.ts",
    "./schemas": "./src/schemas.ts",
    "./recipes": "./src/recipes/index.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SovranBitcoin/nagg-ts.git"
  },
  "dependencies": {
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "@sovranbitcoin/schemas": "*",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@sovranbitcoin/schemas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sovranbitcoin/schemas": "^2.1.0",
    "@types/bun": "^1.3.5",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "postinstall": "node scripts/link-local-siblings.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run type-check && bun run test",
    "bump:patch": "bun pm version patch --no-git-tag-version",
    "bump:minor": "bun pm version minor --no-git-tag-version",
    "bump:major": "bun pm version major --no-git-tag-version"
  }
}
