      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
