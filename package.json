{
  "name": "sovran-monorepo",
  "private": true,
  "version": "0.1.1",
  "packageManager": "bun@1.3.5",
  "description": "Sovran monorepo — the app and its self-contained wallet (colada) and nostr (nagg-ts) packages, plus the docs site.",
  "workspaces": [
    "app",
    "wallet",
    "nostr",
    "docs"
  ],
  "overrides": {
    "@cashu/cashu-ts": "3.5.0",
    "zod": "4.4.3",
    "neverthrow": "8.2.0",
    "react-native-quick-base64": "^3.0.0"
  },
  "scripts": {
    "postinstall": "cd app && node scripts/apply-patches.js && node modules/bitchat-module/scripts/patch-bitchat-imports.js && node modules/bitchat-module/scripts/sync-bitchat-android.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "cd app && bun run dev",
    "start": "cd app && bun run start",
    "ios": "cd app && bun run ios",
    "android": "cd app && bun run android",
    "prebuild": "cd app && bun run prebuild",
    "type-check": "cd app && bun run type-check",
    "lint": "cd app && bun run lint",
    "test": "cd app && bun run test",
    "knip": "cd app && bun run knip",
    "pretty": "cd app && bun run pretty",
    "pretty:check": "cd app && bun run pretty:check",
    "deps:sovran-latest": "cd app && bun run deps:sovran-latest",
    "build:dev:ios": "cd app && bun run build:dev:ios",
    "build:dev:android": "cd app && bun run build:dev:android",
    "build:ios": "cd app && bun run build:ios",
    "build:android": "cd app && bun run build:android",
    "build:android:apk": "cd app && bun run build:android:apk",
    "submit:ios": "cd app && bun run submit:ios",
    "submit:android": "cd app && bun run submit:android",
    "release:ios": "cd app && bun run release:ios"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
