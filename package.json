{
  "name": "Sovran",
  "main": "./index.js",
  "version": "1.0.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "scripts": {
    "start": "expo start",
    "start:emulator:ios": "expo run:ios",
    "start:emulator:android": "expo run:android",
    "build:dev:ios": "eas build --platform ios --profile development --non-interactive",
    "build:dev:android": "eas build --platform android --profile development --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive --auto-submit",
    "build:android:apk": "eas build -p android --profile preview",
    "submit:ios": "eas submit -p ios",
    "submit:android": "eas submit -p android",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "pretty:check": "prettier --check \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "knip": "npx knip",
    "postinstall": "patch-package",
    "prebuild": "expo prebuild --clean",
    "maestro": "maestro test ./.maestro",
    "build:themes": "node scripts/build-background-themes.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "screenshots": "node scripts/resize-screenshots.js",
    "release:freedomstore:pr": "bash scripts/create-freedomstore-pr.sh"
  },
