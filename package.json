{
  "name": "nagg-ts",
  "version": "0.1.0",
  "description": "Typed, UI-agnostic client helpers for generic Nagg GraphQL and app-view APIs.",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./recipes": "./src/recipes/index.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "neverthrow": "^8.2.0"
  },
