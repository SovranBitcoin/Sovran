# Workspace-root ignores. App-specific ignores live in app/.gitignore;
# wallet/, nostr/, docs/ keep their own as needed.

# Hoisted workspace dependencies
node_modules/

# Logs / scratch
*.log
log.txt

# Editor / OS
.vscode
.DS_Store

# Env
.env
.env*.local

# Stale root Expo cache (regenerated under app/.expo)
.expo/

# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/
