# Workspace-root ignores. App-specific ignores live in app/.gitignore;
# wallet/, nostr/, docs/ keep their own as needed.

# Hoisted workspace dependencies
node_modules/

# Local upstream checkouts backing the `file:vendor/*` overrides in
# package.json (cashu-ts, coco). Source trees + build output, repopulated by
# hand — never committed. Root-anchored so app/vendor/marmot-ts, which IS
# tracked, keeps working.
/vendor/

# Confidential security-review reports (see artifacts/README.md — held for
# coordinated disclosure).
/artifacts/

# Logs / scratch
*.log
log.txt

# Editor / OS
.vscode
.DS_Store

# Env
.env
.env*.local

# Stale root Expo cache (regenerated under app/.expo)
.expo/

# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/
app/old_log_2.txt
app/old_log.txt
FEEDBACK.md
app/old_log_3.txt
