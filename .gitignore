# log-doctor working file
log.txt

# WebDriverAgent bring-up log (start-wda.sh)
wda.log

# Phone-test runner artefacts (log-doctor phone test)
#
# Layout:
#   tests/.screenshots/  — per-step PNGs. Binary, noisy. Gitignored.
#   tests/.snapshots/    — per-step pruned AX-tree .snap files.
#                          COMMITTED — drift shows up in PR diffs.
#   tests/.diffs/        — failed-diff dumps written when `stable ... across`
#                          or `assert screen eq` fails. Local-only, gitignored.
#   tests/.test-runs/    — sidecar transcripts from the TTY reporter. Gitignored.
.screenshots/
tests/.screenshots/
tests/.diffs/
tests/.test-runs/

