{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "esnext",

    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["./*"]
    }
  },
  "exclude": ["coco/**/*"],
  "expo": {
    "experiments": {
      "typedRoutes": true
    }
  }
}
