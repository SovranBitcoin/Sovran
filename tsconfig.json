{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "esnext",

    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["./*"],
      "coco-cashu-core": ["./coco/packages/core"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coco/**/*"],
  "expo": {
    "experiments": {
      "typedRoutes": true
    }
  }
}
