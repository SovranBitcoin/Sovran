{
  "cli": {
    "version": ">= 7.8.5"
  },
  "build": {
    "e2e-iOS": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "channel": "e2e-simulator",
      "node": "22.4.0"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.4.0",
      "env": {
        "FLAVOR": "development"
      }
    },
    "preview": {
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.4.0"
    },
    "production": {
      "node": "22.4.0",
      "env": {
        "FLAVOR": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}