{
  "expo": {
    "name": "Sovran",
    "slug": "sovran",
    "version": "0.0.63",
    "orientation": "portrait",
    "scheme": ["sovran", "cashu", "lightning", "lnurl", "lnurlw", "lnurlp", "bitcoin", "nostr"],
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/light.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSCameraUsageDescription": "Sovran will use your camera to scan QR codes to make it easier to send and receive payments.",
        "NSBluetoothAlwaysUsageDescription": "Sovran uses Bluetooth to chat with nearby devices through the BitChat mesh, so you can send messages even when you're offline.",
        "NSBluetoothPeripheralUsageDescription": "Sovran advertises over Bluetooth so nearby devices in the BitChat mesh can find you.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UIBackgroundModes": ["fetch", "bluetooth-central", "bluetooth-peripheral"],
        "UIDeviceFamily": [1],
        "NSMotionUsageDescription": "Sovran uses motion sensor data to create subtle parallax and visual effects while you use the app.",
        "NSPhotoLibraryUsageDescription": "Sovran uses your photo library so you can choose an image that contains a QR code to scan for payments.",
        "NSLocationWhenInUseUsageDescription": "Sovran uses your location while the app is open to show nearby places on the map and to add location context to transactions when you choose to use those features.",
        "NFCReaderUsageDescription": "Sovran uses NFC to send and receive contactless payments."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      },
      "bundleIdentifier": "com.sovranbitcoin",
      "supportsTablet": false
    },
    "android": {
      "versionCode": 2,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dark-t.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ],
      "package": "com.sovranbitcoin"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/light-t.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Sovran uses your camera to scan QR codes for sending and receiving payments."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "includeNdefEntitlement": false,
          "selectIdentifiers": ["D2760000850100", "D2760000850101", "5361746f63617368"]
        }
      ],
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/light-t.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain",
          "imageWidth": 390,
          "dark": {
            "image": "./assets/images/dark-t.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      ["expo-build-properties", { "ios": { "deploymentTarget": "18.0" } }],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MonaSans/MonaSans-Light.ttf",
            "./assets/fonts/MonaSans/MonaSans-Regular.ttf",
            "./assets/fonts/MonaSans/MonaSans-Medium.ttf",
            "./assets/fonts/MonaSans/MonaSans-SemiBold.ttf",
            "./assets/fonts/MonaSans/MonaSans-Bold.ttf",
            "./assets/fonts/MonaSans/MonaSans-ExtraBold.ttf",
            "./assets/fonts/MonaSans/MonaSans-Black.ttf"
          ]
        }
      ],
      "expo-router",
      "expo-localization",
      "expo-video",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      ["@bacons/apple-targets", { "appleTeamId": "2ZTL7KLN2V" }]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "09112d75-3a3a-49ba-bec6-ab881c5a2fa6"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
