GITHUB_TOKEN=replace_with_classic_PAT_with_read_packages
EXPO_PUBLIC_NOSTR_APPVIEW_BASE_URL=https://nagg-production.up.railway.app
EXPO_PUBLIC_NOSTR_GRAPHQL_ENDPOINT=https://nagg-production.up.railway.app/graphql

# Per-view transport flags: when "true" the view's data is served by nagg's REST
# app-view (`/nostr/*`) instead of GraphQL. Both transports parse the SAME
# canonical shape, so output is equivalent. Default off; opt in after device test.
EXPO_PUBLIC_NOSTR_DM_APPVIEW=false
EXPO_PUBLIC_NOSTR_FEED_APPVIEW=false
EXPO_PUBLIC_NOSTR_NOTIFICATIONS_APPVIEW=false

# Shared giveaway P2PK key (nsec or 64-hex). Injected into extra.giveawayP2pkSecret
# for ALL build profiles so any install can redeem ecash locked to its pubkey.
# Generate with: node scripts/gen-giveaway-key.mjs  — never commit the real value.
# SECURITY: bundled keys are extractable; only lock low-value, rotatable giveaways.
GIVEAWAY_P2PK_SECRET=
