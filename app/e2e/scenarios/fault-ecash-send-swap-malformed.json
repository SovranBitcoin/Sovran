{
  "version": 1,
  "lane": "funded",
  "requires": ["fresh-install","cocod.send.cashu","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":20}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-testnut-20"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet",
  "id": "fault.ecash-send.swap-malformed",
  "name": "Send fails (mint replies with garbage) — no blind refund",
  "description": "During a 10-sat send, the mint answers with a garbled response the wallet cannot read. Because the payment might actually have gone through, the wallet does not guess: it checks back with the mint and the balance ends up exactly right.",
  "details": "Fund 20 testnut sats (net 19), make POST /v1/swap answer 200 with truncated JSON, attempt a 10-sat Create Ecash: a parse failure could be a mangled SUCCESS response (the mint may have signed), so it must be treated like a timeout — no blind restore; after the rule clears, reconciliation against the real mint lands the balance at exactly 19 (delta 0)",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","outcome:rolled-back","check:mint-fault","check:fault-tbd"],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"mintFaults","rules":[{"id":"swap-malformed","mint":"https://testnut.cashu.space","path":"/v1/swap","method":"POST","ws":"pass","response":{"mode":"malformed"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"id":"e2e-action-menu-open"},"timeoutMs":30000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"swap-malformed","minCount":1,"timeoutMs":60000},
    {"action":"delay","ms":3000,"reason":"settle window proves no retry hammering after a terminal protocol error"},
    {"action":"tapAt","x":0.5,"y":0.2},
    {"action":"assert","that":"notVisible","selector":{"id":"e2e-action-menu-open"},"timeoutMs":15000},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 19"},"timeoutMs":120000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ]
}
