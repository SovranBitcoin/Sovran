{
  "version": 1,
  "id": "receive.npc.toast-view",
  "name": "Receive to the ecash address — notification opens the payment",
  "description": "50 sats are sent to the wallet's reusable ecash address. When the confirmation notification pops up, tapping its View button jumps straight to the details of that incoming payment.",
  "details": "Open the receive QR display's Lightning address rail, capture the npub.cash address, have cocod pay it 50 sats over LNURL, prove the confirmed toast — then tap the toast's View action and verify it routes directly to the settled incoming npc transaction's detail (the last unproved claim of the retired receive.npc.sat plan)",
  "lane": "funded",
  "tags": ["flow:receive","instrument:npc","io:display","outcome:settled","check:toast"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Lightning"}}],"until":{"id":"receive-lightning-mode-address"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-lightning-mode-address"},"timeoutMs":15000},
    {"action":"waitFor","selector":{"id":"payment-info-address-data"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-qr","stable":true,"tolerance":0.001},
    {"action":"capture","as":"addr","fromSelector":{"id":"payment-info-address-data"},"attribute":"label"},
    {"action":"counterparty","operation":"lightning-address.pay","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":50,"address":"${addr}","timeoutMs":180000},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":300000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"payment-status-view"}}],"until":{"idPrefix":"transaction-probe-"},"attempts":4,"settleMs":4000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"rxTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${rxTx}","direction":"in","unit":"sat","mintHost":"mint.minibits.cash","timeoutMs":30000},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":50,"feeEnvelopeSats":3},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
