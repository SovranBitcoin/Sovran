{
  "version": 1,
  "id": "profile.switcher",
  "name": "Scroll and dismiss the profile switcher",
  "description": "Open the drawer profile switcher in the picker sheet, verify the create control is reachable, and leave it without choosing.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-profile-switcher-open"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-profile-switcher-open"}}],"until":{"id":"picker-sheet"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"profile-create"},"timeoutMs":30000},
    {"action":"assert","that":"visible","selector":{"id":"profile-create"}},
    {"action":"screenshot","name":"profile-switcher"},
    {"action":"tapAt","x":0.5,"y":0.12},
    {"action":"tap","selector":{"id":"flow-header-back"},"optional":{"reason":"iPhone dismisses the sheet with the tap above it; Android leaves the pushed page with Back"}},
    {"action":"assert","that":"notVisible","selector":{"id":"profile-create"},"timeoutMs":5000}
  ],
  "verify": [
    {"action":"assert","that":"notVisible","selector":{"id":"profile-create"}}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
