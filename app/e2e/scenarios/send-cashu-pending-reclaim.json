{
  "version": 1,
  "id": "send.cashu.pending-reclaim",
  "name": "Send ecash, then take the money back (never handed over)",
  "description": "Creates 40 sats of ecash to give someone but never hands it over. The app shows the send as still waiting, and cancelling it returns every sat to the wallet.",
  "details": "Fund 100 sat, create a 40 sat token without handing it off, prove it is pending, check status, cancel it, prove rolledBack and full balance restoration, then sweep the restored balance",
  "lane": "funded",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","outcome:reclaimed"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":100}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-100"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"label":"Create ecash"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"4"}}],"until":{"id":"amount-state:4"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:40"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:40"}},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"pending","source":null},
    {"action":"screenshot","name":"send-token","stable":true,"tolerance":0.001},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 60"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-40},
    {"action":"waitFor","selector":{"id":"transaction-send-${sendTx}"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-send-${sendTx}"}}],"until":{"id":"send-token-id-${sendTx}"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"more-button"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-token-check-status"}}],"until":{"id":"e2e-toast-token-pending-not-redeemed"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"pending","source":null},
    {"action":"tapUntil","sequence":[{"tap":{"id":"more-button"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-token-cancel-transaction"}}],"until":{"id":"e2e-toast-transaction-cancelled"},"attempts":4,"settleMs":12000},
    {"action":"assert","that":"notVisible","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"rolledBack","source":null},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"waitFor","selector":{"id":"transaction-send-${sendTx}"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-send-${sendTx}"}}],"until":{"id":"send-token-id-${sendTx}"},"attempts":4,"settleMs":8000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"label":"Cancelled"}},
    {"action":"assert","that":"visible","selector":{"label":"Funds returned to your balance"}},
    {"action":"screenshot","name":"send-token","stable":true,"tolerance":0.001},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
