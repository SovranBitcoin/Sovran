{
  "version": 1,
  "id": "cta.preview",
  "name": "Call-to-action previews and backup check",
  "description": "Preview both CTAs, exercise blocked navigation back, reopen and verify permanent dismissal, then enter and cancel the backup check on a disposable fresh wallet.",
  "details": "The Back preview control dispatches the real navigator back action; swipe checks gesture rejection. Android hardware-back needs native verification; the JSON harness has no hardware-back step. No updates are installed and no funds are used.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.fresh-install"},
    {"action":"waitFor","selector":{"label":"Get Started"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"down"}}],"until":{"id":"settings-dev-cta"},"attempts":8,"settleMs":1000}
  ],
  "steps": [
    {"action":"tap","selector":{"id":"settings-dev-cta"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta-update-required"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta-update-required"}},
    {"action":"waitFor","selector":{"id":"cta-active"},"timeoutMs":15000,"value":"update-required"},
    {"action":"tap","selector":{"id":"cta-preview-back"}},
    {"action":"swipe","dir":"down"},
    {"action":"waitFor","selector":{"id":"cta-active"},"timeoutMs":15000,"value":"update-required"},
    {"action":"screenshot","name":"cta"},
    {"action":"tap","selector":{"id":"cta-preview-close"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta-update-required"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta-update-required"}},
    {"action":"waitFor","selector":{"id":"cta-active"},"timeoutMs":15000,"value":"update-required"},
    {"action":"tap","selector":{"id":"cta-preview-close"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta-backup-recovery-phrase"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta-backup-recovery-phrase"}},
    {"action":"waitFor","selector":{"id":"cta-active"},"timeoutMs":15000,"value":"backup-recovery-phrase"},
    {"action":"tap","selector":{"id":"cta-dont-ask"}},
    {"action":"tap","selector":{"id":"cta-secondary"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta"}},
    {"action":"waitFor","selector":{"id":"settings-dev-cta-backup-recovery-phrase"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"settings-dev-cta-backup-recovery-phrase"}},
    {"action":"waitFor","selector":{"id":"cta-active"},"timeoutMs":15000,"value":"backup-recovery-phrase"},
    {"action":"waitFor","selector":{"id":"cta-dismissed"},"timeoutMs":15000,"value":"1"},
    {"action":"tap","selector":{"id":"cta-primary"}},
    {"action":"waitFor","selector":{"id":"profile-reveal-mnemonic"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"profile-reveal-mnemonic"}},
    {"action":"waitFor","selector":{"id":"profile-recovery-written"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"profile-recovery-written"}},
    {"action":"waitFor","selector":{"id":"recovery-phrase-confirm"},"timeoutMs":15000},
    {"action":"screenshot","name":"recovery-phrase-confirm"},
    {"action":"tap","selector":{"id":"recovery-choice-0"}},
    {"action":"tap","selector":{"id":"recovery-confirm-cancel"}},
    {"action":"waitFor","selector":{"id":"profile-reveal-mnemonic"},"timeoutMs":15000},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":15000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
