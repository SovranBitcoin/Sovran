{
  "version": 1,
  "id": "recovery.reinstall",
  "name": "Recover the iOS wallet after deleting and reinstalling the app",
  "description": "On iOS, the app is deleted and reinstalled while Keychain keeps its securely saved secrets. After accepting the terms and going through recovery, the wallet comes back with the same profile name and its known mints.",
  "details": "Capture the preceding onboarding scenario's drawer profile name, perform a true iOS uninstall/reinstall, pass Terms and RestoreGate using the Keychain-retained mnemonic, recover known mints, and prove the inherited profile name is unchanged. Android is excluded because uninstall removes Expo SecureStore's Android Keystore key.",
  "lane": "simulator",
  "tags": ["flow:recovery"],
  "requires": ["fresh-install","reinstall.keychain-retention"],
  "setup": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"drawer-profile-name"},"timeoutMs":30000},
    {"action":"capture","as":"profileNameBefore","fromSelector":{"id":"drawer-profile-name"},"attribute":"label"},
    {"action":"screenshot","name":"drawer","stable":true,"tolerance":0.001}
  ],
  "steps": [
    {"action":"launch","reset":"reinstall"},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"state":"enabled"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Continue to Privacy"}}],"until":{"label":"Privacy"},"attempts":4,"settleMs":1000},
    {"action":"screenshot","name":"privacy"},
    {"action":"waitFor","selector":{"id":"privacy-acknowledgment"},"state":"enabled"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"privacy-acknowledgment"}}],"until":{"id":"privacy-acknowledgment"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Confirm and continue"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"label":"Confirm and continue"}},
    {"action":"waitFor","selector":{"label":"Recover Wallet"},"timeoutMs":180000},
    {"action":"assert","that":"visible","selector":{"id":"slide-to-confirm"}},
    {"action":"screenshot","name":"restore-gate","stable":true,"tolerance":0.001},
    {"action":"drag","selector":{"id":"slide-to-confirm"},"from":{"x":0.07,"y":0.5},"to":{"x":0.97,"y":0.5},"durationMs":800},
    {"action":"waitFor","selector":{"label":"Recovery Complete"},"timeoutMs":300000},
    {"action":"screenshot","name":"recovery-complete","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"label":"Continue"}},
    {"action":"waitFor","selector":{"id":"header-profile-avatar"},"timeoutMs":180000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-profile-name"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"drawer-profile-name"},"timeoutMs":30000},
    {"action":"assert","that":"ax","selector":{"id":"drawer-profile-name"},"label":"${profileNameBefore}"},
    {"action":"screenshot","name":"drawer","stable":true,"tolerance":0.001},
    {"action":"goHome"},
    {"action":"assert","that":"notVisible","selector":{"label":"Close drawer"},"timeoutMs":30000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":60000},
    {"action":"screenshot","name":"wallet","stable":true,"tolerance":0.001}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
