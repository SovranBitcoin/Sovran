{
  "version": 1,
  "id": "onboarding.terms-gate",
  "name": "Setup can't continue until the terms are accepted",
  "description": "On a fresh install, the Next button on the terms screen stays disabled until the agreement box is ticked. Once ticked, Next unlocks and setup can continue all the way to the wallet.",
  "details": "On a fresh install, the Terms & Conditions screen's Next button is DISABLED until the acceptance checkbox is ticked — proving a brand-new user cannot skip past terms. Assert Next is disabled before checking, tick the box, assert Next becomes enabled, then complete the carousel and land on the wallet. The gating axis on onboarding (onboarding.fresh only proved the happy full journey)",
  "lane": "simulator",
  "tags": ["flow:onboarding","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [],
  "steps": [
    {"action":"launch","reset":"erase"},
    {"action":"tapAt","x":0.68,"y":0.54},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"screenshot","name":"terms"},
    {"action":"assert","that":"ax","selector":{"label":"Next"},"state":{"enabled":false}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Next"},"state":"enabled","timeoutMs":30000},
    {"action":"assert","that":"ax","selector":{"label":"Next"},"state":{"enabled":true}},
    {"action":"screenshot","name":"terms"},
    {"action":"tap","selector":{"label":"Next"}},
    {"action":"waitFor","selector":{"label":"Bitcoin that feels like cash"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Bitcoin that feels like cash"}}],"until":{"label":"Powered by Nostr"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Powered by Nostr"}}],"until":{"label":"Private by Design"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Private by Design"}}],"until":{"label":"Stay private, stay sovereign"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"label":"Welcome to Sovran"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"label":"No History"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"wallet"}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
