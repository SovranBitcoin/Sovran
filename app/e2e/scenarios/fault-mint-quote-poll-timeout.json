{
  "version": 1,
  "lane": "simulator",
  "requires": ["fresh-install","mock.mint-faults","unit.sat"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet",
  "id": "fault.mint-quote.poll-timeout",
  "name": "Payment status checks hang — the displayed invoice stays up",
  "description": "The wallet shows a Lightning invoice for topping up, but every background check on whether it was paid hangs forever. The invoice stays on screen without crashing or being replaced by an error, and once the mint responds again the screen closes normally.",
  "details": "Create a real 100-sat invoice at the default mint, then hang every GET quote poll: the displayed invoice must persist (no crash, no error takeover) while the watcher's polls time out in-flight; the ledger proves polls were actually intercepted. Clearing the rules unblocks the app and the flow dismisses cleanly (the unpaid quote is abandoned as usual)",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","io:display","check:mint-fault"],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Receive"}}],"until":{"label":"Fixed Amount"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Fixed Amount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:100"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"id":"payment-info-lightning-invoice-data"},"timeoutMs":60000},
    {"action":"mintFaults","rules":[{"id":"quote-poll-timeout","mint":"*","path":"/v1/mint/quote/bolt11","method":"GET","ws":"down","response":{"mode":"timeout"}}]},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"quote-poll-timeout","minCount":1,"timeoutMs":60000},
    {"action":"assert","that":"visible","selector":{"label":"Copy"}},
    {"action":"screenshot","name":"lightning-receive"},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"}
  ]
}
