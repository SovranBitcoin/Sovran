    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"wallpaper-option-velvet-emerald"},"attempts":6,"settleMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallpaper-option-velvet-emerald"}}],"until":{"id":"theme-apply"},"attempts":4,"settleMs":6000},
