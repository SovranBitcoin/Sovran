    {"action":"tapUntil","sequence":[{"tap":{"id":"wallpaper-option-twilight-amber"}}],"until":{"id":"theme-apply"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"theme-apply"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Wallpaper image none for twilight-amber"},"timeoutMs":45000},
