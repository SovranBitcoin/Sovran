{
  "version": 1,
  "id": "capture.wallpapers",
  "name": "Every built-in wallpaper applied to the wallet",
  "description": "Apply each wallpaper in the built-in colours album and capture the wallet under it. Only this disposable profile's own appearance changes.",
  "details": "All eight built-in wallpapers are captured, not a selected few: dark, light, navy, sunset, beige, crimson night, twilight amber and velvet emerald. The picker is scrolled until each option is actually on screen before it is tapped, because the list runs past the viewport. Readiness is the wallet's own wallpaper probe for that theme, so a capture cannot be attributed to the wallpaper that was applied before it. Downloaded albums are a separate contract and are not touched here.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-theme"}}],"until":{"id":"unit-card-sat"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"unit-card-sat"}}],"until":{"id":"wallpaper-option-navy"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"wallpaper-option-navy"},"timeoutMs":30000},
    {"action":"screenshot","name":"theme-background","delayMs":1200},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"wallpaper-option-dark"},"attempts":6,"settleMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallpaper-option-dark"}}],"until":{"id":"theme-apply"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"theme-apply"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Wallpaper image none for dark"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet","delayMs":2000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-theme"}}],"until":{"id":"unit-card-sat"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"unit-card-sat"}}],"until":{"id":"wallpaper-option-light"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"wallpaper-option-light"},"attempts":6,"settleMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallpaper-option-light"}}],"until":{"id":"theme-apply"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"theme-apply"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":6000},
