{
  "version": 1,
  "id": "mint.add.mixed-discovery-manual",
  "name": "Add a suggested mint and a typed one together",
  "description": "Picks one mint from the built-in suggestions and types another one's web address, then confirms both in a single step. Both new mints show up in the mint list afterwards.",
  "details": "Open Add Mints, check one discovery-catalog mint (21mint.me), then open URL search and also check manually-entered testnut.cashu.space (a validated pseudo-mint row), and confirm both in the same batch add — proving discovery and manual selections coexist in one confirm; both rows must appear in the selector afterwards; ends on wallet",
  "lane": "simulator",
  "tags": ["flow:mint","check:mint-add"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://21mint.me"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://21mint.me"}}],"until":{"label":"Add (1)"},"attempts":4,"settleMs":4000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://testnut.cashu.space"}}],"until":{"label":"Add (2)"},"attempts":4,"settleMs":4000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"waitFor","selector":{"id":"mint-add-confirm"},"state":"enabled","timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-confirm"}}],"until":{"id":"e2e-toast-mints-added"},"attempts":6,"settleMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"mint-add-confirm"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"mint-select-add"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://21mint.me"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://21mint.me"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-mint-selector"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
