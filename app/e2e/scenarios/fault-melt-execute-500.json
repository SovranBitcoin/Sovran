{
  "version": 1,
  "id": "fault.melt.execute-500",
  "name": "Mint has a server error mid Lightning payment — verified refund",
  "description": "While paying a 10-sat Lightning invoice, the mint replies with a generic server error, so the payment might or might not have gone through. The wallet does not guess: it confirms with the mint that the invoice was never paid before returning the money.",
  "details": "Fund 20 testnut sats (net 19), real 10-sat melt quote, then POST /v1/melt/bolt11 returns a bare 500: the server may have paid before failing, so this is the same ambiguity class as offline — proofs sit reserved on the executing op and coco's executing-recovery checks the melt quote at the LIVE mint (status GET unfaulted), verifies UNPAID, and only then rolls back: SEND CANCELLED timeline (Funds returned to your balance; no popup on this path) and balance back at 18 (the execute-phase swap fee costs 1 sat). Documents current behavior: an immediate blind restore on 5xx would be a funds-safety bug",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","amount:fixed","outcome:rolled-back","check:mint-fault","check:fault-tbd"],
  "requires": ["fresh-install","cocod.send.cashu","cocod.receive.bolt11","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":20}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-testnut-20"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"id":"melt-pay"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"meltTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${meltTx}","direction":"out","amount":10,"unit":"sat","mintHost":"testnut.cashu.space","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"mintFaults","rules":[{"id":"melt-exec-500","mint":"https://testnut.cashu.space","path":"/v1/melt/bolt11","method":"POST","ws":"pass","response":{"mode":"httpStatus","status":500,"body":"Internal Server Error"}}]},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"waitFor","selector":{"label":"Funds returned to your balance"},"timeoutMs":60000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"melt-exec-500","minCount":1},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 18"},"timeoutMs":180000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0,"feeEnvelopeSats":1},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
