{
  "version": 1,
  "id": "receive.qr-display.offline",
  "name": "Receive QR codes still work in simulated offline mode",
  "description": "With the app's simulated offline mode switched on, the standing receive QR screen still shows working, copyable codes on both its tabs — no crash, endless spinner, or dead end. Switching back online returns the wallet to normal.",
  "details": "With Mock Offline on (dev toggle; YOU ARE OFFLINE shell banner committed), the standing receive QR display still works: the Unified tab renders its copyable payload and the Cashu tab renders the locally-encoded NUT-18 creq (P2PK state probe present) — no crash, spinner, or dead-end; toggling back online restores the wallet",
  "lane": "simulator",
  "tags": ["flow:receive","io:display","check:offline"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-offline-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-offline-toggle"}}],"until":{"id":"settings-mock-offline-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":15000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Cashu"}}],"until":{"id":"receive-creq-p2pk-state"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state"},"timeoutMs":15000},
    {"action":"assert","that":"visible","selector":{"id":"receive-copy"}},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-offline-toggle"},"value":"1","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-offline-toggle"}}],"until":{"id":"settings-mock-offline-toggle"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
