{
  "version": 1,
  "lane": "simulator",
  "requires": ["fresh-install","mock.mint-faults","unit.sat"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet",
  "id": "fault.mint-add.unreachable",
  "name": "Adding a mint that can't be reached fails cleanly (three ways)",
  "description": "Tries to add a new mint three times while that mint is down, broken, or answering with nonsense. Every attempt fails without crashing, and no half-added mint is left behind in the mint list.",
  "details": "Fresh wallet attempts to add testnut three times while its /v1/info is (1) offline, (2) a bare 500, (3) malformed JSON: discovery must fail without crashing and WITHOUT persisting a half-configured mint in any leg — 5xx and offline are the same unreachable class, and a malformed body must not slip through as trusted. After all legs the mint selector still lists no testnut row",
  "tags": ["flow:mint","check:mint-fault","check:mint-add"],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"mintFaults","rules":[{"id":"info-offline","mint":"https://testnut.cashu.space","path":"/","ws":"down","response":{"mode":"offline"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"delay","ms":8000,"reason":"discovery window: the faulted mint must not become addable"},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tap","selector":{"label":"Cancel"},"optional":{"reason":"dismissal chrome varies when discovery fails"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"info-offline","minCount":1},
    {"action":"mintFaults","rules":[{"id":"info-500","mint":"https://testnut.cashu.space","path":"/","ws":"down","response":{"mode":"httpStatus","status":500,"body":"Internal Server Error"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"delay","ms":8000,"reason":"discovery window: the faulted mint must not become addable"},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tap","selector":{"label":"Cancel"},"optional":{"reason":"dismissal chrome varies when discovery fails"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"info-500","minCount":1},
    {"action":"mintFaults","rules":[{"id":"info-malformed","mint":"https://testnut.cashu.space","path":"/","ws":"down","response":{"mode":"malformed"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"delay","ms":8000,"reason":"discovery window: the faulted mint must not become addable"},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tap","selector":{"label":"Cancel"},"optional":{"reason":"dismissal chrome varies when discovery fails"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"info-malformed","minCount":1},
    {"action":"mintFaults","rules":[]}
  ],
  "verify": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ]
}
