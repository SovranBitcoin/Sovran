{
  "version": 1,
  "id": "receive.lightning.change-mint.amount",
  "name": "Receive via a Lightning invoice — change mint on the amount screen",
  "description": "While setting up a 125-sat Lightning receive, the wallet is switched to a different mint before confirming. The amount survives the switch, the invoice comes from the newly chosen mint, and the payment settles there.",
  "details": "Enter 125 sat, switch from the preferred mint to Minibits, prove the amount survives, prove the unpaid quote names the selected mint, then cocod pays the invoice, the receive settles at Minibits, and the run ends on wallet after sweeping the mint",
  "lane": "funded",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","check:mint-change","outcome:settled"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":125}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"2"}}],"until":{"id":"amount-state:12"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"5"}}],"until":{"id":"amount-state:125"},"attempts":4,"settleMs":3000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:125"}},
    {"action":"screenshot","name":"receive-amount","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-mint-selector"}}],"until":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:125"}},
    {"action":"screenshot","name":"receive-amount","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"mint-quote-id-","captureSuffixAs":"quoteTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","amount":125,"unit":"sat","mintHost":"mint.minibits.cash","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"capture","as":"invoice","fromSelector":{"id":"payment-info-lightning-invoice-data"},"attribute":"label"},
    {"action":"counterparty","operation":"bolt11.pay","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":125,"invoice":"${invoice}","timeoutMs":120000},
    {"action":"waitFor","selector":{"label":"Close"},"timeoutMs":180000},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","amount":125,"unit":"sat","mintHost":"mint.minibits.cash","status":"ISSUED","timeoutMs":30000},
    {"action":"tap","selector":{"label":"Close"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 125"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":125},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"tap","selector":{"label":"Cancel"},"optional":{"reason":"Quote screen may already have been dismissed after a failed assertion"}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
