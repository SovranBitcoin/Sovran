{
  "version": 1,
  "id": "backup.flow",
  "name": "Verify all twelve recovery words",
  "description": "Practice the full backup in development Mock Mode using a display-only public test vector. Never verifies a real wallet.",
  "details": "Settings → profile → backup row. Three choices at each position are selected by accessibility label from the deterministic demo plan. No marketing captures. Native large-text, screen-reader and swipe behavior still need device validation.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"}
  ],
  "steps": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"id":"settings-profile-row"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-profile-row"}}],"until":{"id":"settings-backup-row"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-backup-row"}}],"until":{"id":"backup-intro"},"attempts":4,"settleMs":4000},
    {"action":"assert","that":"visible","selector":{"id":"backup-demo"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"backup-show-words"}}],"until":{"id":"backup-words"},"attempts":4,"settleMs":4000},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-1"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-2"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-3"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-4"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-5"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-6"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-7"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-8"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-9"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-10"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-11"}},
    {"action":"assert","that":"visible","selector":{"id":"backup-word-12"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"backup-written"}}],"until":{"id":"backup-verify"},"attempts":4,"settleMs":4000},
    {"action":"waitFor","selector":{"label":"1 of 12"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, legal"}}],"until":{"label":"2 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 3, winner"}}],"until":{"label":"3 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, thank"}}],"until":{"label":"4 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 2, year"}}],"until":{"label":"5 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, wave"}}],"until":{"label":"6 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 2, sausage"}}],"until":{"label":"7 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, worth"}}],"until":{"label":"8 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, useful"}}],"until":{"label":"9 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 1, legal"}}],"until":{"label":"10 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 3, winner"}}],"until":{"label":"11 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 3, thank"}}],"until":{"label":"12 of 12"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Option 2, yellow"}}],"until":{"id":"backup-done"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"backup-done-button"}}],"until":{"id":"settings-backup-row"},"attempts":4,"settleMs":4000},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"1","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
