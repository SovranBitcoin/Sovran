{
  "version": 1,
  "id": "theme.wallpaper.cancel",
  "name": "Change a wallpaper (cancelled, nothing applied)",
  "description": "Starts changing the wallpaper and previews a new album, then taps Cancel instead of Apply. The wallet returns exactly as it was, with no wallpaper applied.",
  "details": "Open Theme, pick the Artemis II album card (which stages a wallpaper draft on the preview, proven theme.wallpaper.apply legs), then tap Cancel instead of Apply: the draft is discarded and the wallet returns with wallet-wallpaper:none still set — no wallpaper was committed. The dismiss/cancel axis on the theme flow, distinct from theme.wallpaper.apply/apply-second/relaunch which commit",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"waitFor","selector":{"id":"wallet-wallpaper:none"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-theme"}}],"until":{"id":"theme-preview-theme-button"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"id":"theme-preview-theme-button"}},
    {"action":"waitFor","selector":{"id":"album-card-artemis-ii-collection"},"timeoutMs":60000},
    {"action":"screenshot","name":"gallery"},
    {"action":"tap","selector":{"id":"album-card-artemis-ii-collection"}},
    {"action":"waitFor","selector":{"id":"theme-cancel"},"timeoutMs":30000},
    {"action":"screenshot","name":"theme-preview"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"theme-cancel"}}],"until":{"id":"wallet-wallpaper:none"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"wallet-wallpaper:artemis-ii-collection"}},
    {"action":"screenshot","name":"wallet"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"assert","that":"visible","selector":{"id":"wallet-wallpaper:none"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
