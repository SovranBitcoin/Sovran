{
  "version": 1,
  "id": "send.cashu.change-mint.amount",
  "name": "Send ecash (switch mints while typing the amount)",
  "description": "While preparing to send 40 sats of ecash, the tester switches which mint the money should come from without losing the typed amount. The ecash is created from the newly chosen mint and our test partner wallet redeems it successfully.",
  "details": "Fund Sovran and Minibits 50/50 over Lightning, open Create Ecash (preselected to preferred Sovran, proven by the amount-selected-mint probe), type 40, switch the mint to Minibits from the amount screen's selector, and prove the typed amount SURVIVES the round trip (amount-state:40 remains visible, probe flips to mint.minibits.cash). Create the token from Minibits, cocod redeems it (finalized out-tx at mint.minibits.cash), delta -40 within a small swap-fee envelope; dual sweep to zero. Proves PAY-5.1-MINT-AMOUNT's live device leg; the P2PK-lock survival variant (PAY-5.1-P2PK-MINT) remains a separate backlog row",
  "lane": "funded",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","check:mint-change","outcome:settled"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50},{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.sovran.money","mintHost":"mint.sovran.money"}},
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":45000},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}},
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"amount-selected-mint:mint.sovran.money"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"4"}}],"until":{"id":"amount-state:4"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:40"},"attempts":4,"settleMs":3000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:40"}},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-mint-selector"}}],"until":{"label":"Select Mint"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"amount-selected-mint:mint.minibits.cash"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:40"}},
    {"action":"screenshot","name":"send-amount"},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.minibits.cash","status":"pending"},
    {"action":"screenshot","name":"send-token","stable":true,"tolerance":0.001},
    {"action":"waitFor","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"capture","as":"token","fromSelector":{"id":"payment-info-token-data"},"attribute":"label"},
    {"action":"counterparty","operation":"cashu.redeem","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":40,"token":"${token}","timeoutMs":120000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.minibits.cash","status":"finalized","timeoutMs":120000},
    {"action":"assert","that":"notVisible","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-40,"feeEnvelopeSats":3},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
