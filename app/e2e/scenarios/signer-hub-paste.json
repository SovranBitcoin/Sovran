{
  "version": 1,
  "id": "signer.hub.paste",
  "name": "Remote Login pairing link review",
  "description": "From the Remote Login hub, open Paste Connection Link, type a nostrconnect:// URI (cocod's real public pubkey as a stand-in client — a valid curve point, unlike an all-zero key which parse rejects; real relay host, e2e secret) via typeText, and Connect: the signer-connect review sheet opens (action-menu probe value signer-connect), then it is dismissed without approving — no pairing is granted. Proves paste → validate → pairing-review",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-remote-login"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-remote-login"}}],"until":{"id":"signer-hub-paste-row"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"signer-hub-paste-row"},"timeoutMs":45000},
    {"action":"screenshot","name":"signer-hub"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"signer-hub-paste-row"}}],"until":{"label":"Connect"},"attempts":4,"settleMs":6000},
    {"action":"typeText","focus":{"x":0.5,"y":0.755},"value":"nostrconnect://ec8cffdc71b36063e2c971a061a03ce886932bb7db8782bf5f6384348e9f7db3?relay=wss%3A%2F%2Frelay.damus.io&secret=e2e-test-secret&name=E2E-Harness"},
    {"action":"screenshot","name":"signer-hub"},
    {"action":"tapUntil","sequence":[{"tapAt":{"x":0.5,"y":0.937}}],"until":{"id":"e2e-action-menu-open"},"untilValue":"signer-connect","attempts":3,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"e2e-action-menu-open"},"value":"signer-connect","timeoutMs":30000},
    {"action":"screenshot","name":"signer-hub"},
    {"action":"tapAt","x":0.5,"y":0.15},
    {"action":"delay","ms":2000,"reason":"connect-review sheet dismissal exposes no AX signal"},
    {"action":"waitFor","selector":{"id":"signer-hub-paste-row"},"timeoutMs":30000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
