{
  "version": 1,
  "id": "store.screenshots",
  "name": "App store screenshots",
  "description": "Fourteen curated screens in one phone session, including mint details, Lightning receive history, transactions, feed, notifications and AI. Uses presentation fixtures; no money or messages are sent.",
  "details": "Presentation capture only, not payment settlement proof. Reuses existing demo mode on a disposable device. Run with --evidence screenshots --no-record to keep named images, failure evidence, and final-state proof without per-action screenshots or state dumps.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.fresh-install"},
    {"action":"waitFor","selector":{"label":"Get Started"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.macadamia.cash"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.macadamia.cash"}}],"until":{"id":"wallet-selected-mint:mint.macadamia.cash"},"attempts":4,"settleMs":6000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"mint-select","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-inspect:https://mint.macadamia.cash"}}],"until":{"id":"mint-info-close"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"mint-info","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-view-all"}}],"until":{"id":"screen-transactions"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"transactions","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-mint-demo-mint-1"}}],"until":{"id":"mint-quote-id-demo-mint-1"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"lightning-receive","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"visible","selector":{"label":"kelbie"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"id":"demo-feed-ready"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"feed","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-notifications"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-notifications"}}],"until":{"id":"screen-notifications"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"notifications","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-ai"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-ai"}}],"until":{"id":"screen-ai"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"ai","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-contacts"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-contacts"}}],"until":{"idPrefix":"contact-row:nostr:"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:nostr:c673ff0b5f22","captureSuffixAs":"storeContact"},"timeoutMs":30000},
    {"action":"screenshot","name":"contacts","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:nostr:c673ff0b5f22${storeContact}"}},{"delayMs":4000},{"swipe":{"dir":"up"}},{"swipe":{"dir":"down"}}],"until":{"id":"send-message-menu"},"attempts":3,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"send-message-menu"},"timeoutMs":90000},
    {"action":"screenshot","name":"profile"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-split"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-split"}}],"until":{"id":"mint-distribution-next"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"balance-split","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive-qr","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"send","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"1","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-mint-demo-"}},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-send-demo-"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"label":"kelbie"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"demo-feed-ready"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
