{
  "version": 1,
  "id": "receive.cashu.unknown-mint",
  "name": "Receive ecash from an unknown mint (pasted) — accept the mint",
  "description": "Pasting a 10-sat ecash token from a mint the wallet has never seen brings up a screen asking whether to trust that mint. Accepting adds the mint and the redeem completes, landing at 9 sats after the mint's 1-sat fee.",
  "details": "cocod mints a 10 sat testnut token the wallet has never seen; redeeming routes through the mint-trust review screen, tapping Add mint trusts testnut and returns to the token preview where redeem is tapped again; testnut charges a 1 sat redeem fee so the wallet lands on 9, and the valueless test-mint principal is auto-written-off instead of swept",
  "lane": "funded",
  "tags": ["flow:receive","instrument:cashu-token","io:paste","outcome:settled","check:mint-add"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":10}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"incomingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-paste"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-paste"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-paste"}}],"until":{"id":"receive-token-redeem"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"mint-info-trust"},"timeoutMs":60000},
    {"action":"screenshot","name":"mint-info"},
    {"action":"tap","selector":{"id":"mint-info-trust"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":120000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"waitFor","selector":{"id":"receive-token-close"},"timeoutMs":120000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"receiveTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${receiveTx}","direction":"in","amount":10,"unit":"sat","mintHost":"testnut.cashu.space","status":"finalized","source":"paste"},
    {"action":"tap","selector":{"id":"receive-token-close"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 9"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":10,"feeEnvelopeSats":1},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
