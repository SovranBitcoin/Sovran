{
  "version": 1,
  "id": "transactions.filter.source",
  "name": "Filter transactions by how they arrived (paste vs QR scan)",
  "description": "After receiving one payment by pasting an ecash token, the source filter is checked: filtering to 'Paste' shows that payment, and filtering to 'QR' hides it, since nothing arrived by QR scan.",
  "details": "Fund 50 at Minibits over Lightning (a mint tx with no scan source) and paste-redeem a 30-sat Sovran token (finalized receive with source=paste, proven by the tx probe), then prove the annotation-driven Source filter: Paste leaves exactly the paste receive row, QR hides it (no tx carries a QR source). Both mints sweep to zero",
  "lane": "funded",
  "tags": ["flow:history","instrument:cashu-token","io:paste","amount:fixed","check:filters","check:tx-source"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.send.cashu","unit.sat","cocod.receive.cashu"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50},{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":30}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}},
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":45000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":30,"captureAs":"incomingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-paste"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-paste"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-paste"}}],"until":{"id":"receive-token-redeem"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":120000},
    {"action":"waitFor","selector":{"id":"receive-token-close"},"timeoutMs":120000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"receiveTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${receiveTx}","direction":"in","amount":30,"unit":"sat","mintHost":"mint.sovran.money","status":"finalized","source":"paste"},
    {"action":"tap","selector":{"id":"receive-token-close"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 80"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-view-all"}}],"until":{"id":"transactions-filter-open"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"label":"Pending"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Pending"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"label":"Paste"},"timeoutMs":15000},
    {"action":"tap","selector":{"label":"Paste"}},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transaction-receive-${receiveTx}"},"timeoutMs":30000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"label":"Pending"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Pending"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"label":"QR"},"timeoutMs":15000},
    {"action":"tap","selector":{"label":"QR"}},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transactions-filter-open"},"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"transaction-receive-${receiveTx}"}},
    {"action":"screenshot","name":"transactions"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":30},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
