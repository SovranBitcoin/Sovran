{
  "version": 1,
  "id": "receive.lightning.usd-dismiss",
  "name": "Receive via a Lightning invoice in dollar display — then cancel",
  "description": "With the wallet switched to its dollar display, a Lightning invoice asking for 5 cents is created and shown, then dismissed without being paid. No money moves; this proves dollar-denominated receiving works all the way to the invoice screen.",
  "details": "Switch the wallet to the USD account (preferred mint snaps to mint.cubabitcoin.org), enter $0.05 on the fiat keypad, create a USD NUT-04 mint quote as Lightning, prove the sat-denominated invoice renders with an UNPAID usd tx probe, then dismiss without payment — deliberately dismiss-only: cocod is sat-only, so no funds move and no cleanup is needed",
  "lane": "simulator",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","io:display","outcome:dismissed","check:fiat-unit"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-unit-switcher"}}],"until":{"label":"USD account"},"attempts":6,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"USD account"}}],"until":{"id":"wallet-selected-mint:mint.cubabitcoin.org"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"5"}}],"until":{"id":"amount-state:5"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"quoteTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","unit":"usd","mintHost":"mint.cubabitcoin.org","status":"UNPAID"},
    {"action":"waitFor","selector":{"id":"payment-info-lightning-invoice-data"},"timeoutMs":30000},
    {"action":"screenshot","name":"lightning-receive"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-selected-mint:mint.cubabitcoin.org"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
