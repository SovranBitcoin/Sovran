{
  "version": 1,
  "id": "mint.add.multiple",
  "name": "Add three suggested mints at once",
  "description": "Ticks three mints from the built-in suggestion list and confirms them all in one go. All three appear in the wallet's mint list afterwards.",
  "details": "Open Add Mints from the mint selector, wait for three visible discovery rows, capture and check those runtime mint URLs, confirm the batch add, then prove those exact URLs appear through a bounded bidirectional selector traversal immediately and after reopening it; ends on wallet",
  "lane": "simulator",
  "tags": ["flow:mint","check:mint-add"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:mint:","matchIndex":2},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:mint:","matchIndex":0,"captureSuffixAs":"mintOneUrl"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:mint:","matchIndex":1,"captureSuffixAs":"mintTwoUrl"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:mint:","matchIndex":2,"captureSuffixAs":"mintThreeUrl"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:${mintOneUrl}"}}],"until":{"label":"Add (1)"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:${mintTwoUrl}"}}],"until":{"label":"Add (2)"},"attempts":4,"settleMs":4000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:${mintThreeUrl}"}}],"until":{"label":"Add (3)"},"attempts":4,"settleMs":4000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"waitFor","selector":{"id":"mint-add-confirm"},"state":"enabled","timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-confirm"}}],"until":{"id":"e2e-toast-mints-added"},"attempts":8,"settleMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"mint-add-confirm"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"mint-select-add"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintOneUrl}"},"attempts":2,"settleMs":1000},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintTwoUrl}"},"attempts":2,"settleMs":1000},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintThreeUrl}"},"attempts":2,"settleMs":1000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintOneUrl}"},"attempts":2,"settleMs":1000},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintTwoUrl}"},"attempts":2,"settleMs":1000},
    {"action":"tapUntil","sequence":[{"delayMs":100},{"swipe":{"dir":"down"}},{"swipe":{"dir":"down"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"contact-row:mint:${mintThreeUrl}"},"attempts":2,"settleMs":1000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-mint-selector"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
