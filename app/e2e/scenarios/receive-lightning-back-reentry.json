{
  "version": 1,
  "id": "receive.lightning.back-reentry",
  "name": "Receive bolt11 (fixed amount) [back-nav re-entry]",
  "description": "Regression guard for the dead-Next back-nav wedge (395889e1): enter 21 sat, Next opens the variants menu, pick Lightning, reach the UNPAID Sovran quote, go BACK (flow-header-back pops to the receive hub — hub choices restart fresh via startReceiveLightning reset:true), re-enter Fixed Amount, type 210, then prove Next still opens the variants menu a SECOND time (the exact popup openSeq wedge) and mints a fresh 210-sat quote. Both quotes stay unpaid and are dismissed; no funds move",
  "lane": "simulator",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","io:display","outcome:dismissed","check:navigation"],
  "requires": ["fresh-install","unit.sat"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"2"}},
    {"action":"tap","selector":{"label":"1"}},
    {"action":"assert","that":"ax","selector":{"id":"amount-value"},"value":"21"},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"screenshot","name":"receive-amount","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"mint-quote-id-","captureSuffixAs":"quote1"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quote1}","direction":"in","amount":21,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"waitFor","selector":{"id":"payment-info-lightning-invoice-data"},"timeoutMs":30000},
    {"action":"screenshot","name":"lightning-receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"flow-header-back"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"2"}},
    {"action":"tap","selector":{"label":"1"}},
    {"action":"tap","selector":{"label":"0"}},
    {"action":"assert","that":"ax","selector":{"id":"amount-value"},"value":"210"},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"mint-quote-id-","captureSuffixAs":"quote2"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quote2}","direction":"in","amount":210,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-receive"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
