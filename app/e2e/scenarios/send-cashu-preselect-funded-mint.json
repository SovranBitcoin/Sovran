{
  "version": 1,
  "id": "send.cashu.preselect-funded-mint",
  "name": "Send ecash (the mint holding the money is pre-chosen)",
  "description": "With money at only one of two mints, starting an ecash send automatically picks the mint that actually has funds. The full 50 sats are sent as ecash and our test partner wallet redeems them.",
  "details": "Fund 50 at Minibits while the preferred Sovran mint stays empty: Send → Create ecash must open the amount screen preselected to the funded Minibits mint (amount-selected-mint probe), then create a token for the full 50 there, let cocod redeem it (which IS the cleanup — balance ends at 0), and end on wallet at -50",
  "lane": "funded",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","io:copy","outcome:settled","check:mint-preselect"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"amount-selected-mint:mint.minibits.cash"},"timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"5"}}],"until":{"id":"amount-state:5"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:50"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":50,"unit":"sat","mintHost":"mint.minibits.cash","status":"pending","source":null},
    {"action":"screenshot","name":"send-token"},
    {"action":"waitFor","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"capture","as":"token","fromSelector":{"id":"payment-info-token-data"},"attribute":"label"},
    {"action":"counterparty","operation":"cashu.redeem","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":50,"token":"${token}","timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":50,"unit":"sat","mintHost":"mint.minibits.cash","status":"finalized","source":null,"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-50,"feeEnvelopeSats":2},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
