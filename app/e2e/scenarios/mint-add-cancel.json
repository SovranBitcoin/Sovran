{
  "version": 1,
  "id": "mint.add.cancel",
  "name": "Add a mint but cancel — nothing is saved",
  "description": "Starts adding a new mint by typing its web address, then backs out instead of confirming. Reopening the mint list proves the cancelled mint was never saved.",
  "details": "From the wallet-header mint selector, open Add Mints, type testnut and wait for its result row (proven mint.add.url legs), then Cancel WITHOUT confirming: the flow pops back to the mint selector and testnut is NOT in the list — reopening the selector confirms the dismissed mint was never persisted. The cancel/back axis on mint-add, distinct from mint.add.url which confirms",
  "lane": "simulator",
  "tags": ["flow:mint","check:mint-add"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-cancel"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"assert","that":"notVisible","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"assert","that":"notVisible","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
