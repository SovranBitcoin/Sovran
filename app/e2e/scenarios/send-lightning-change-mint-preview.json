{
  "version": 1,
  "id": "send.lightning.change-mint.preview",
  "name": "Send bolt11 (paste) [change mint at preview]",
  "description": "Fund Sovran and Minibits independently, open one 40 sat invoice preview on Sovran, switch to Minibits at confirmation, prove the destination and amount survive, pay once from Minibits, and sweep both residual balances",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","check:mint-change","outcome:settled"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":100},{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":80}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-100"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"state":"enabled","timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tap","selector":{"label":"8"}},
    {"action":"tap","selector":{"label":"0"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-mint-selector"}}],"until":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"assert","that":"ax","selector":{"id":"amount-value"},"value":"80"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":6000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"minibitsFundTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${minibitsFundTx}","direction":"in","amount":80,"unit":"sat","mintHost":"mint.minibits.cash","status":"UNPAID"},
    {"action":"capture","as":"minibitsInvoice","fromSelector":{"id":"payment-info-lightning-invoice-data"},"attribute":"label"},
    {"action":"counterparty","operation":"bolt11.pay","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":80,"invoice":"${minibitsInvoice}","timeoutMs":120000},
    {"action":"waitFor","selector":{"label":"Close"},"timeoutMs":180000},
    {"action":"tap","selector":{"label":"Close"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Send"},"timeoutMs":45000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":40,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"label":"Allow Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"}},
    {"action":"waitFor","selector":{"idPrefix":"melt-selected-mint:mint.sovran.money:","captureSuffixAs":"initialPreviewTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${initialPreviewTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"capture","as":"invoiceFingerprint","fromSelector":{"id":"melt-destination-fingerprint"},"attribute":"value"},
    {"action":"screenshot","name":"lightning-send","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"melt-mint-selector"}}],"until":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"timeoutMs":60000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"}},
    {"action":"waitFor","selector":{"idPrefix":"melt-selected-mint:mint.minibits.cash:","captureSuffixAs":"changedPreviewTx"},"timeoutMs":60000},
    {"action":"assert","that":"ax","selector":{"id":"melt-destination-fingerprint"},"value":"${invoiceFingerprint}"},
    {"action":"assert","that":"tx","txRef":"${changedPreviewTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.minibits.cash","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-send","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"waitFor","selector":{"id":"melt-close"},"timeoutMs":120000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"paidMeltTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${paidMeltTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.minibits.cash","status":"PAID"},
    {"action":"counterparty","operation":"bolt11.settled","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":40,"invoice":"${invoice}","timeoutMs":60000},
    {"action":"tap","selector":{"id":"melt-close"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-40,"feeEnvelopeSats":5},
    {"action":"screenshot","name":"wallet","stable":true,"tolerance":0.001}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
