{
  "version": 1,
  "id": "feed.thread.backnav",
  "name": "Feed survives thread visits",
  "description": "Opens the For You feed, enters a post's thread, scrolls the replies, and navigates back — three times — asserting after each return that the feed still renders post content. Reproduces the blank/corrupted feed reported after thread back-navigation (frozen FlashList under the thread screen).",
  "details": "Feed content presence is asserted via the post-zap footer testID, which every rendered PostCard exposes; a blank/virtualization-corrupted feed list has no post-zap nodes in the AX tree while the For You pills (outside the list) still render. Thread entry taps the card body by coordinates (cards expose no tappable root id); thread landing marker is the Reply-sort control's accessibility label. Back is the native-stack header Back button with an edge-swipe fallback.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"For You"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"id":"post-zap"},"timeoutMs":45000},
    {"action":"screenshot","name":"feed"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"post-comment"},"attempts":8,"settleMs":2000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"post-comment"}}],"until":{"label":"Post your reply"},"attempts":4,"settleMs":5000},
    {"action":"waitFor","selector":{"label":"Post your reply"},"timeoutMs":30000},
    {"action":"screenshot","name":"thread"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"flow-header-close"}}],"until":{"label":"For You"},"attempts":4,"settleMs":3000},
    {"action":"delay","ms":1500,"reason":"settle window after back-navigation so the unfrozen feed list finishes whatever re-layout it attempts before the content assert"},
    {"action":"screenshot","name":"feed"},
    {"action":"assert","that":"visible","selector":{"id":"post-zap"}},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"post-comment"},"attempts":8,"settleMs":2000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"post-comment"}}],"until":{"label":"Post your reply"},"attempts":4,"settleMs":5000},
    {"action":"waitFor","selector":{"label":"Post your reply"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"flow-header-close"}}],"until":{"label":"For You"},"attempts":4,"settleMs":3000},
    {"action":"delay","ms":1500,"reason":"settle window after back-navigation so the unfrozen feed list finishes whatever re-layout it attempts before the content assert"},
    {"action":"screenshot","name":"feed"},
    {"action":"assert","that":"visible","selector":{"id":"post-zap"}},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}},{"swipe":{"dir":"up"}}],"until":{"id":"post-comment"},"attempts":8,"settleMs":2000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"post-comment"}}],"until":{"label":"Post your reply"},"attempts":4,"settleMs":5000},
    {"action":"waitFor","selector":{"label":"Post your reply"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"flow-header-close"}}],"until":{"label":"For You"},"attempts":4,"settleMs":3000},
    {"action":"delay","ms":1500,"reason":"settle window after back-navigation so the unfrozen feed list finishes whatever re-layout it attempts before the content assert"},
    {"action":"screenshot","name":"feed"}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"post-zap"}},
    {"action":"screenshot","name":"feed"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
