{
  "version": 1,
  "id": "transactions.filter.status",
  "name": "Transaction Status filter separates Pending from Confirmed",
  "description": "Fund 100 (confirmed in-tx), compose a 40-sat ecash send and leave it deliberately PENDING (Check Status toasts pending-not-redeemed, goHome keeps it open), then prove the Status filter: Pending shows the pending send row, Confirmed hides it. Finally reclaim the pending token from its wallet-home row (Cancel → transaction-cancelled), restoring the full 100 before sweep — pending tokens can only be reclaimed or redeemed, never abandoned",
  "lane": "funded",
  "tags": ["flow:history","instrument:cashu-token","amount:fixed","outcome:reclaimed","check:filters"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat","cocod.receive.cashu"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":100}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-100"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"label":"Create ecash"},"timeoutMs":30000},
    {"action":"tap","selector":{"label":"4"}},
    {"action":"tap","selector":{"label":"0"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"pending","source":null},
    {"action":"screenshot","name":"send-token"},
    {"action":"tap","selector":{"id":"more-button"}},
    {"action":"tapAt","x":0.5,"y":0.84},
    {"action":"waitFor","selector":{"id":"e2e-toast-token-pending-not-redeemed"},"timeoutMs":10000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 60"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-view-all"}}],"until":{"id":"transactions-filter-open"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"label":"Pending"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Pending"},"timeoutMs":30000},
    {"action":"tap","selector":{"label":"Pending"}},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transaction-send-${sendTx}"},"timeoutMs":30000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"label":"Confirmed"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Confirmed"},"timeoutMs":30000},
    {"action":"tap","selector":{"label":"Confirmed"}},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transactions-filter-open"},"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"transaction-send-${sendTx}"}},
    {"action":"screenshot","name":"transactions"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-send-${sendTx}"}}],"until":{"id":"payment-info-token-data"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"more-button"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":6000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"id":"e2e-toast-transaction-cancelled"},"timeoutMs":60000},
    {"action":"assert","that":"notVisible","selector":{"id":"payment-info-token-data"},"timeoutMs":30000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
