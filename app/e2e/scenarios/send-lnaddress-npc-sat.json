{
  "version": 1,
  "id": "send.lnaddress.npc.sat",
  "name": "Send to an ecash address (previewed, then backed out)",
  "description": "Pastes our test partner wallet's ecash address, enters 40 sats, and reaches the ready-to-pay screen — then backs out without paying, because the partner wallet cannot yet confirm receiving this kind of payment.",
  "details": "Fund 100 at Sovran, paste cocod's npc lightning address, enter 40 on the amount screen (preselected to Sovran), reach the melt preview on Sovran and dismiss it — cocod exposes no npc claim surface yet, so the payment itself stays unsettled by design; flips to a settled send once an npc.settled counterparty op is observable",
  "lane": "funded",
  "tags": ["flow:send","instrument:npc","amount:fixed","io:paste","outcome:dismissed"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.npc.address","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":100}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-100"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"npc.address","captureAs":"addr","setClipboard":true,"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"send"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"id":"amount-selected-mint:mint.sovran.money"},"timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"4"}}],"until":{"id":"amount-state:4"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:40"},"attempts":4,"settleMs":3000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:40"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.82},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"melt-selected-mint:mint.sovran.money:"},"timeoutMs":15000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"tap","selector":{"id":"melt-cancel"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
