{
  "version": 1,
  "id": "receive.lightning.change-mint.confirm",
  "name": "Receive via a Lightning invoice — change mint on the invoice screen",
  "description": "A 150-sat Lightning receive is confirmed at the usual mint, then the mint is switched on the invoice screen itself. A fresh invoice from the new mint appears with the same amount, and the payment settles at the new mint.",
  "details": "Enter 150 sat and confirm at the preferred mint, then switch to Minibits on the quote screen itself, prove a fresh unpaid quote names Minibits with the amount intact, cocod pays the new invoice, the receive settles at Minibits, and the run ends on wallet after sweeping the mint",
  "lane": "funded",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","check:mint-change","outcome:settled"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":150}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"5"}}],"until":{"id":"amount-state:15"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:150"},"attempts":4,"settleMs":3000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:150"}},
    {"action":"screenshot","name":"receive-amount","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"mint-quote-id-","captureSuffixAs":"quoteA"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteA}","direction":"in","amount":150,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"quote-mint-selector"}},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"contact-row:mint:https://mint.minibits.cash/Bitcoin"}},
    {"action":"assert","that":"notVisible","selector":{"id":"mint-quote-id-${quoteA}"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"mint-quote-id-","captureSuffixAs":"quoteB"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteB}","direction":"in","amount":150,"unit":"sat","mintHost":"mint.minibits.cash","status":"UNPAID","timeoutMs":30000},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"capture","as":"invoice","fromSelector":{"id":"payment-info-lightning-invoice-data"},"attribute":"label"},
    {"action":"counterparty","operation":"bolt11.pay","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":150,"invoice":"${invoice}","timeoutMs":120000},
    {"action":"waitFor","selector":{"label":"Close"},"timeoutMs":180000},
    {"action":"assert","that":"tx","txRef":"${quoteB}","direction":"in","amount":150,"unit":"sat","mintHost":"mint.minibits.cash","status":"ISSUED","timeoutMs":30000},
    {"action":"tap","selector":{"label":"Close"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 150"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":150},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"tap","selector":{"label":"Cancel"},"optional":{"reason":"Quote screen may already have been dismissed after a failed assertion"}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
