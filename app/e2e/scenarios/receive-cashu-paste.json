{
  "version": 1,
  "id": "receive.cashu.paste",
  "name": "Receive cashu token (paste)",
  "description": "cocod mints a 50 sat sovran token; app pastes and redeems; assert +50 and end on wallet",
  "lane": "funded",
  "tags": ["flow:receive","instrument:cashu-token","io:paste","outcome:settled"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":50,"captureAs":"incomingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"tap","selector":{"id":"wallet-receive"}},
    {"action":"waitFor","selector":{"id":"receive-method-paste"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive"},
    {"action":"tap","selector":{"id":"receive-method-paste"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":120000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"waitFor","selector":{"id":"receive-token-close"},"timeoutMs":120000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"receiveTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${receiveTx}","direction":"in","amount":50,"unit":"sat","mintHost":"mint.sovran.money","status":"finalized","source":"paste"},
    {"action":"tap","selector":{"id":"receive-token-close"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":50},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
