{
  "version": 1,
  "id": "drawer.navigation",
  "name": "Visit every screen in the side menu",
  "description": "Visits each side-menu destination and checks that swiping back from Mint updates returns to Notifications without opening the drawer. Requires a recorded update from a trusted mint; returns to the wallet.",
  "details": "Open the drawer and visit Feed, Contacts, Notifications, AI and Remote Login, then return to the wallet. The Notifications back-swipe leg requires at least one recorded update from a trusted mint under Mints; fresh-install onboarding alone does not guarantee this data. It opens the first visible mint-change-row using its existing semantic ID, then drags right from 1% of the full-width detail list to exercise the left-edge back gesture. Assert the drawer stays closed, the Notifications title returns, and root drawer gestures work again. Contacts/Notifications nav-title ids and native gesture behavior still require device verification.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"drawer"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"For You"},"timeoutMs":45000},
    {"action":"screenshot","name":"feed"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-contacts"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-contacts"}}],"until":{"id":"Contacts"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"Contacts"},"timeoutMs":45000},
    {"action":"screenshot","name":"contacts"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-notifications"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-notifications"}}],"until":{"id":"Notifications"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"Notifications"},"timeoutMs":45000},
    {"action":"screenshot","name":"notifications"},
    {"action":"tap","selector":{"id":"notifications-tab-mints"}},
    {"action":"waitFor","selector":{"idPrefix":"mint-change-row:","matchIndex":0},"timeoutMs":45000},
    {"action":"tap","selector":{"idPrefix":"mint-change-row:","matchIndex":0}},
    {"action":"waitFor","selector":{"label":"Mint updates"}},
    {"action":"waitFor","selector":{"id":"mint-changes-detail"}},
    {"action":"drag","selector":{"id":"mint-changes-detail"},"from":{"x":0.01,"y":0.5},"to":{"x":0.85,"y":0.5},"durationMs":400},
    {"action":"assert","that":"notVisible","selector":{"id":"drawer-profile-name"}},
    {"action":"waitFor","selector":{"id":"Notifications"}},
    {"action":"assert","that":"notVisible","selector":{"id":"mint-changes-detail"}},
    {"action":"drag","selector":{"id":"mint-changes-list"},"from":{"x":0.01,"y":0.5},"to":{"x":0.85,"y":0.5},"durationMs":400},
    {"action":"waitFor","selector":{"id":"drawer-profile-name"}},
    {"action":"tap","selector":{"id":"drawer-menu-notifications"}},
    {"action":"assert","that":"notVisible","selector":{"id":"drawer-profile-name"}},
    {"action":"tap","selector":{"id":"notifications-tab-app"}},
    {"action":"assert","that":"visible","selector":{"id":"notification-app-legal"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-ai"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-ai"}},{"delayMs":1200},{"tap":{"id":"tab-ai"}}],"until":{"id":"ai-model-chip"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"ai-model-chip"},"timeoutMs":45000},
    {"action":"screenshot","name":"ai"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-remote-login"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-remote-login"}}],"until":{"id":"signer-hub-paste-row"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"signer-hub-paste-row"},"timeoutMs":45000},
    {"action":"screenshot","name":"signer-hub"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
