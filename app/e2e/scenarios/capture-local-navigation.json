{
  "version": 1,
  "id": "capture.local-navigation",
  "name": "Local navigation without connecting or paying",
  "description": "View Remote Login, empty receive amount entry, camera permission information and the unavailable-page screen. No connection, quote, camera access or payment is created.",
  "details": "Copies signer hub and receive amount entry legs but stops before their effectful actions. Camera permission is revoked, never granted. Unknown-route readiness is source-backed and still requires native validation.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-remote-login"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-remote-login"}}],"until":{"id":"signer-hub-paste-row"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"signer-hub-paste-row"},"timeoutMs":45000},
    {"action":"screenshot","name":"signer-hub"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"permission","service":"camera","mode":"revoke"},
    {"action":"launch","reset":"none"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"openUrl","url":"sovran://camera"},
    {"action":"waitFor","selector":{"label":"Camera permission required"},"timeoutMs":15000},
    {"action":"screenshot","name":"camera"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"openUrl","url":"sovran:///capture-deliberately-unknown-route"},
    {"action":"waitFor","selector":{"id":"not-found-go-wallet"},"timeoutMs":30000},
    {"action":"screenshot","name":"not-found"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"not-found-go-wallet"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":6000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
