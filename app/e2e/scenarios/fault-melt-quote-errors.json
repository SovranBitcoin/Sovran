{
  "version": 1,
  "id": "fault.melt.quote-errors",
  "name": "Paying a Lightning invoice fails before it starts — nothing is taken",
  "description": "The wallet tries to pay a Lightning invoice while the mint is unreachable, and again while the mint rejects the request outright. Both times the payment fails with a clear message and no money ever leaves the wallet.",
  "details": "Fund 20 testnut sats (net 19). Leg 1: kill POST /v1/melt/quote/bolt11 and pay a pasted cocod 10-sat invoice — the preview screen itself is synthetic (no network), the quote is only created on Pay, and prepare fails pre-debit: the melt-failed toast (payment-status-melt-failed) renders and nothing is reserved or swapped. Leg 2: swap the rule to 400 {11006 amount outside limits} and pay again — the protocol error surfaces through the same melt-failed toast (the static offline-vs-protocol popup classification is UNREACHABLE on the melt path — routeOperationFailure emits the payment toast, never the error-step popup; documented asymmetry vs the proven mint-quote path). Nothing is ever debited in either leg (delta 0, balance 19 — quote failure precedes the execute-phase swap)",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","outcome:dismissed","check:mint-fault","check:toast"],
  "requires": ["fresh-install","cocod.send.cashu","cocod.receive.bolt11","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":20}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-testnut-20"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"mintFaults","rules":[{"id":"melt-quote-offline","mint":"https://testnut.cashu.space","path":"/v1/melt/quote/bolt11","method":"POST","ws":"pass","response":{"mode":"offline"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"label":"Allow Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"}},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"waitFor","selector":{"id":"payment-status-melt-failed"},"timeoutMs":60000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"melt-quote-offline","minCount":1},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"mintFaults","rules":[{"id":"melt-quote-11006","mint":"https://testnut.cashu.space","path":"/v1/melt/quote/bolt11","method":"POST","ws":"pass","response":{"mode":"error","code":11006,"detail":"Amount must be between 1 and 1000000"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Paste"}},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"iOS only prompts on the first host-set clipboard read of a session"}},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"waitFor","selector":{"id":"payment-status-melt-failed"},"timeoutMs":60000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"melt-quote-11006","minCount":1},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 19"},"timeoutMs":60000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
