{
  "version": 1,
  "id": "send.lightning.preselect-funded-mint",
  "name": "Pay a Lightning invoice (the mint holding the money is pre-chosen)",
  "description": "With money at only one of two mints, pasting a 30-sat Lightning invoice automatically picks the mint that actually has funds, and the invoice is paid from there.",
  "details": "Fund 50 at Minibits while the preferred Sovran mint stays empty: pasting a 30 sat cocod invoice must open the melt preview on the funded Minibits mint (melt-selected-mint probe), pay it there, and end on wallet with the fee-enveloped -30",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","outcome:settled","check:mint-preselect"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":30,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"send"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"id":"melt-pay"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"melt-selected-mint:mint.minibits.cash:"},"timeoutMs":15000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"waitFor","selector":{"id":"melt-close"},"timeoutMs":120000},
    {"action":"assert","that":"visible","selector":{"id":"melt-close"}},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"meltTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${meltTx}","direction":"out","amount":30,"unit":"sat","mintHost":"mint.minibits.cash","status":"PAID"},
    {"action":"counterparty","operation":"bolt11.settled","mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"amount":30,"invoice":"${invoice}","timeoutMs":60000},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-30,"feeEnvelopeSats":5},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
