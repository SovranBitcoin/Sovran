{
  "version": 1,
  "id": "transactions.filter.mint",
  "name": "Filter transactions by mint",
  "description": "With 50 sats received at each of two different mints, the mint filter is checked both ways: choosing one mint shows only its transaction, and switching to the other mint hides it.",
  "details": "Fund 50 at Sovran and 50 at Minibits (two confirmed in-txs at different mints), then prove the Mint filter: selecting Minibits leaves exactly one mint row (captured unambiguously), and switching to Sovran hides that row while still showing a mint row. Mint chips carry new filter-mint-<url> testIDs with AX selection state; both mints sweep to zero",
  "lane": "funded",
  "tags": ["flow:history","instrument:bolt11","amount:fixed","check:filters","check:mint-change"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat","cocod.receive.cashu"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50},{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.sovran.money","mintHost":"mint.sovran.money"}},
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":45000},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}},
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-view-all"}}],"until":{"id":"transactions-filter-open"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"id":"filter-mint-https://mint.minibits.cash/Bitcoin"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"filter-mint-https://mint.minibits.cash/Bitcoin"},"timeoutMs":30000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"filter-mint-https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"filter-mint-https://mint.minibits.cash/Bitcoin"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"idPrefix":"transaction-mint-","captureSuffixAs":"minibitsTx"},"timeoutMs":30000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"id":"filter-mint-https://mint.sovran.money"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"filter-mint-https://mint.sovran.money"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"filter-mint-https://mint.sovran.money"}}],"until":{"id":"filter-mint-https://mint.sovran.money"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transactions-filter-open"},"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"transaction-mint-${minibitsTx}"}},
    {"action":"screenshot","name":"transactions"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
