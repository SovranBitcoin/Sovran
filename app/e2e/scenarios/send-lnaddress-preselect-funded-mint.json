{
  "version": 1,
  "id": "send.lnaddress.preselect-funded-mint",
  "name": "Send to an ecash address (the mint holding the money is pre-chosen)",
  "description": "With money at only one of two mints, pasting an ecash address automatically picks the mint that actually has funds and keeps that choice through to the ready-to-pay screen, which is then backed out of without paying.",
  "details": "Fund 50 at Minibits while the preferred Sovran mint stays empty: pasting cocod's npc lightning address must open the amount screen preselected to the funded Minibits mint (amount-selected-mint probe) and carry it into the melt preview, which is then dismissed — cocod exposes no npc claim surface yet, so the payment itself stays unsettled by design",
  "lane": "funded",
  "tags": ["flow:send","instrument:npc","amount:fixed","io:paste","outcome:dismissed","check:mint-preselect"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.npc.address","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"npc.address","captureAs":"addr","setClipboard":true,"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"send"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"label":"Allow Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"id":"amount-selected-mint:mint.minibits.cash"},"timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"3"}}],"until":{"id":"amount-state:3"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:30"},"attempts":4,"settleMs":3000},
    {"action":"assert","that":"visible","selector":{"id":"amount-state:30"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.82},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"melt-selected-mint:mint.minibits.cash:"},"timeoutMs":15000},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"tap","selector":{"id":"melt-cancel"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
