{
  "version": 1,
  "id": "capture.account-entry",
  "name": "Account forms and public keys without changing them",
  "description": "Read the address claim form, recovery entry, public key list and own public profile QR. Never claim an address, recover ecash, generate or import keys, or copy secrets.",
  "details": "Fresh disposable profile, Mock Mode off. Recovery remains idle. Keyring readiness is emitted only after a successful read; its resting rows and QR contain public keys only. The secret-bearing pairing screen is not visited. New route legs require native verification.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"openUrl","url":"sovran:///claimUsername"},
    {"action":"waitFor","selector":{"id":"claim-username-input"},"state":"enabled","timeoutMs":30000},
    {"action":"assert","that":"ax","selector":{"id":"claim-username-continue"},"state":{"enabled":false}},
    {"action":"screenshot","name":"claim-username","delayMs":1200},
    {"action":"tap","selector":{"id":"claim-username-close"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"settings-recovery-row"},"attempts":6,"settleMs":1000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-recovery-row"}}],"until":{"id":"recovery-cancel"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Recover ecash"},"timeoutMs":30000},
    {"action":"assert","that":"visible","selector":{"id":"slide-to-confirm"}},
    {"action":"assert","that":"notVisible","selector":{"id":"recovery-stop"}},
    {"action":"screenshot","name":"settings-recovery"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"recovery-cancel"}}],"until":{"id":"settings-keyring-row"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-keyring-row"}}],"until":{"id":"keyring-public-keys-ready"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"keyring-public-keys-ready"},"timeoutMs":30000},
    {"action":"screenshot","name":"settings-keyring"},
    {"action":"tap","selector":{"id":"keyring-close"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-profile-name"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-profile-name"}}],"until":{"id":"user-profile:own"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"profile-share-qr"}}],"until":{"id":"payment-info-npub-data"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"profile-share","delayMs":1200},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
