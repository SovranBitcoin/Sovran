{
  "version": 1,
  "id": "receive.cashu.unknown-mint.reject",
  "name": "Receive cashu token from an unknown mint (paste) [reject]",
  "description": "cocod mints a 10 sat testnut token the wallet has never seen; redeeming routes through the mint-trust review screen where the secondary button REJECTS the mint, returning to the token preview untrusted; the preview is cancelled, then the mint selector proves testnut was never added and the balance never moved — the trust gate actually gates. Valueless testnut principal is auto-written-off (token stays unredeemed), no sweep",
  "lane": "funded",
  "tags": ["flow:receive","instrument:cashu-token","io:paste","outcome:dismissed","check:mint-add"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":10}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"incomingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-paste"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-paste"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-paste"}}],"until":{"label":"Allow Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"mint-info-trust"},"timeoutMs":60000},
    {"action":"screenshot","name":"mint-info"},
    {"action":"tap","selector":{"id":"mint-info-close"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-cancel"}},
    {"action":"goHome"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"screenshot","name":"mint-select","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-receive"},"timeoutMs":45000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet","stable":true,"tolerance":0.001}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
