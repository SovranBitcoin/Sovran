{
  "version": 1,
  "id": "receive.lightning.qr",
  "name": "Receive money via a Lightning invoice (scanned as a QR code)",
  "description": "The wallet shows a 33-sat Lightning invoice as a QR code and our test partner wallet pays it the way a scanner would, reading it straight off the screen. A notification confirms the money arrived, and tapping View opens the matching transaction.",
  "details": "Display a fresh 33 sat Lightning invoice QR and have the counterparty pay it as a scanner would (invoice read from the displayed screen, never copied), prove the toast moves from processing to Received with a View action, and verify View opens the exact paid mint transaction",
  "lane": "funded",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","io:display","outcome:settled","check:toast"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":33}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"3"}}],"until":{"id":"amount-state:3"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"3"}}],"until":{"id":"amount-state:33"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"quoteTx"},"timeoutMs":30000},
    {"action":"capture","as":"invoice","fromSelector":{"id":"payment-info-lightning-invoice-data"},"attribute":"label"},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"counterparty","operation":"bolt11.pay","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":33,"invoice":"${invoice}","timeoutMs":120000},
    {"action":"waitFor","selector":{"idPrefix":"payment-status-receive-"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":180000},
    {"action":"tap","selector":{"id":"payment-status-view"}},
    {"action":"waitFor","selector":{"id":"transaction-probe-${quoteTx}"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","amount":33,"unit":"sat","mintHost":"mint.sovran.money","status":"finalized"},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 33"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":33},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
