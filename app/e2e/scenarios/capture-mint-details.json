{
  "version": 1,
  "id": "capture.mint-details",
  "name": "Mint info and reviews for every default mint",
  "description": "Open each default mint's info screen and its reviews from the mint selector. Read-only: no mint is added, removed, trusted or made preferred.",
  "details": "The four default mints (Minibits, macadamia, antifiat, Cuba Bitcoin) each get their real NUT-06 info screen and their real reviews. Info and audit status come from the live mint; reviews come from relays, so a mint with no reviews shows its own empty summary rather than another mint's. Inspecting never changes the selected mint.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"mint-inspect:https://mint.minibits.cash/Bitcoin"},"attempts":4,"settleMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-inspect:https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"mint-info-reviews"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"mint-info-reviews"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-info","delayMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-info-reviews"}}],"until":{"idPrefix":"mint-reviews-profile-"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"idPrefix":"mint-reviews-profile-"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-reviews","delayMs":2500},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"mint-inspect:https://mint.macadamia.cash"},"attempts":4,"settleMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-inspect:https://mint.macadamia.cash"}}],"until":{"id":"mint-info-reviews"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"mint-info-reviews"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-info","delayMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-info-reviews"}}],"until":{"idPrefix":"mint-reviews-profile-"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"idPrefix":"mint-reviews-profile-"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-reviews","delayMs":2500},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"mint-inspect:https://antifiat.cash"},"attempts":4,"settleMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-inspect:https://antifiat.cash"}}],"until":{"id":"mint-info-reviews"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"mint-info-reviews"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-info","delayMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-info-reviews"}}],"until":{"idPrefix":"mint-reviews-profile-"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"idPrefix":"mint-reviews-profile-"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-reviews","delayMs":2500},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"mint-inspect:https://mint.cubabitcoin.org"},"attempts":4,"settleMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-inspect:https://mint.cubabitcoin.org"}}],"until":{"id":"mint-info-reviews"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"mint-info-reviews"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-info","delayMs":1500},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-info-reviews"}}],"until":{"idPrefix":"mint-reviews-profile-"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"idPrefix":"mint-reviews-profile-"},"timeoutMs":45000},
    {"action":"screenshot","name":"mint-reviews","delayMs":2500},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
