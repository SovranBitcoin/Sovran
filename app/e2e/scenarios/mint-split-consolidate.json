{
  "version": 1,
  "id": "mint.split.consolidate",
  "name": "Move all money onto one mint with Balance split",
  "description": "With 50 sats held at each of two mints, the Balance split screen is used to direct everything to a single mint. The wallet moves the money over, lands back home showing the combined balance, and the transfer appears in the history.",
  "details": "Fund Sovran and Minibits with 50 sat each over Lightning, open Balance split, switch every other default mint off (Minibits, Chorus, Cuba) so Sovran holds 100%, run the rebalance (one Minibits-to-Sovran Lightning transfer), land on wallet with the consolidated balance, open the swap detail from the home history row and close it back to home, then sweep; one sweep invocation reconciles every declared asset host-side, including the fee-headroom residual the rebalancer leaves at Minibits",
  "lane": "funded",
  "tags": ["flow:mint","check:rebalance"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50},{"mintUrl":"https://mint.minibits.cash/Bitcoin","unit":"sat","accountIndex":0,"maxPrincipal":50}],"transfers":[{"fromMintUrl":"https://mint.minibits.cash/Bitcoin","toMintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxFeeSats":10}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.sovran.money","mintHost":"mint.sovran.money"}},
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":45000},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.minibits.cash/Bitcoin","mintHost":"mint.minibits.cash"}},
    {"action":"waitFor","selector":{"label":"₿ 100"},"timeoutMs":60000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-split"}}],"until":{"id":"mint-distribution-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"mint-distribution-toggle:https://mint.minibits.cash/Bitcoin"},"timeoutMs":30000},
    {"action":"screenshot","name":"balance-split","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-distribution-toggle:https://mint.minibits.cash/Bitcoin"}}],"until":{"id":"mint-distribution-toggle:https://mint.minibits.cash/Bitcoin"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-distribution-toggle:https://mint.chorus.community"}}],"until":{"id":"mint-distribution-toggle:https://mint.chorus.community"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-distribution-toggle:https://mint.cubabitcoin.org"}}],"until":{"id":"mint-distribution-toggle:https://mint.cubabitcoin.org"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"assert","that":"ax","selector":{"id":"mint-distribution-toggle:https://mint.sovran.money"},"value":"1","state":{"enabled":false}},
    {"action":"screenshot","name":"balance-split","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-distribution-next"}}],"until":{"id":"rebalance-start"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Total to move"},"timeoutMs":30000},
    {"action":"screenshot","name":"rebalance-plan","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"rebalance-start"}},
    {"action":"waitFor","selector":{"id":"rebalance-done"},"timeoutMs":180000},
    {"action":"screenshot","name":"rebalance-plan"},
    {"action":"tap","selector":{"id":"rebalance-done"}},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"swap-row-","captureSuffixAs":"swapGroup"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"swap-row-${swapGroup}"}}],"until":{"id":"swap-id-${swapGroup}"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"swap"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"flow-header-close"}}],"until":{"label":"Split"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-5,"feeEnvelopeSats":5},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
