{
  "version": 1,
  "id": "receive.npc.change-mint",
  "name": "Receive to the ecash address — after switching its mint",
  "description": "The wallet's reusable ecash address is pointed at a different mint than its default, and then 50 sats are sent to the address. The transaction record proves the money landed at the newly chosen mint, not the old default.",
  "details": "Open the receive QR display's Lightning address rail, switch the npc receive mint from the Minibits default to Sovran (server-persisted), have cocod pay the address 50 sats over LNURL, then open the transaction from the wallet list and verify it settled at Sovran, not Minibits",
  "lane": "funded",
  "tags": ["flow:receive","instrument:npc","io:display","outcome:settled","check:mint-change","check:tx-source"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Lightning"}}],"until":{"id":"receive-lightning-mode-address"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-lightning-mode-address"},"timeoutMs":15000},
    {"action":"waitFor","selector":{"id":"payment-info-address-data"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-qr","stable":true,"tolerance":0.001},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-npc-mint-row"}}],"until":{"label":"Select Mint"},"attempts":6,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.sovran.money"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.sovran.money"}}],"until":{"id":"payment-info-address-data"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"e2e-toast-receive-mint-updated"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"id":"payment-info-address-data"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"capture","as":"addr","fromSelector":{"id":"payment-info-address-data"},"attribute":"label"},
    {"action":"counterparty","operation":"lightning-address.pay","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":50,"address":"${addr}","timeoutMs":180000},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":300000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-mint-","captureSuffixAs":"rxRow"},"timeoutMs":60000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-mint-${rxRow}"}}],"until":{"idPrefix":"transaction-probe-"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"rxTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${rxTx}","direction":"in","unit":"sat","mintHost":"mint.sovran.money","timeoutMs":30000},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":50,"feeEnvelopeSats":3},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
