{
  "version": 1,
  "id": "capture.onboarding",
  "name": "Guarded first-run pages",
  "description": "Capture terms, privacy, the four introduction slides and welcome using visible readiness instead of timing the splash screen.",
  "details": "Copies the fresh-install and onboarding legs without the legacy blind launch tap or timer-only splash capture. No native run yet. Creates only a disposable local profile.",
  "lane": "simulator",
  "tags": ["flow:onboarding","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [],
  "steps": [
    {"action":"launch","reset":"erase"},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"state":"enabled"},
    {"action":"screenshot","name":"terms"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Continue to Privacy"}}],"until":{"label":"Privacy"},"attempts":4,"settleMs":1000},
    {"action":"waitFor","selector":{"id":"privacy-acknowledgment"},"state":"enabled"},
    {"action":"screenshot","name":"privacy"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"privacy-acknowledgment"}}],"until":{"id":"privacy-acknowledgment"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Confirm and continue"},"state":"enabled"},
    {"action":"tap","selector":{"label":"Confirm and continue"}},
    {"action":"waitFor","selector":{"label":"Small payments on your phone"},"timeoutMs":60000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Small payments on your phone"}}],"until":{"label":"Carry your profile with you"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Carry your profile with you"}}],"until":{"label":"Understand your privacy"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Understand your privacy"}}],"until":{"label":"Start small"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"label":"Welcome to Sovran"},"attempts":4,"settleMs":3000},
    {"action":"screenshot","name":"welcome"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"label":"No History"},"attempts":4,"settleMs":8000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [],
  "endState": "wallet"
}
