{
  "version": 1,
  "id": "transactions.pending.batch-cancel",
  "name": "Cancel all pending sends with one tap",
  "description": "With a 20-sat send still waiting to be picked up, the pending list offers a single 'Cancel 1 pending' button. Tapping it takes the money back in one step and the wallet balance returns to the full amount.",
  "details": "Fund 50, create a 20-sat ecash token left pending, open the full transactions list and filter to Pending: the 'Cancel 1 pending (20 SAT)' sweep footer appears (exact deterministic label), tapping it reclaims the send in place — the pending row disappears into the empty-state card and the full balance is restored with no double-reclaim. CURRENT-BEHAVIOR NOTE proven by the first run: the batch path REMOVES the transaction record entirely (no rolledBack audit entry) — unlike the single detail-menu cancel, which persists 'Cancelled / Funds returned' (send.cashu.pending-reclaim); a product decision should reconcile the two. Swept",
  "lane": "funded",
  "tags": ["flow:history","instrument:cashu-token","amount:fixed","outcome:reclaimed","check:filters"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.sovran.money","mintHost":"mint.sovran.money"}}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Create ecash"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"2"}}],"until":{"id":"amount-state:2"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:20"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":20,"unit":"sat","mintHost":"mint.sovran.money","status":"pending"},
    {"action":"screenshot","name":"send-token"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 30"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-20},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-view-all"}}],"until":{"id":"transactions-filter-open"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transactions-filter-open"}}],"until":{"label":"Pending"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Pending"}},
    {"action":"tap","selector":{"id":"filter-apply"}},
    {"action":"waitFor","selector":{"id":"transaction-send-${sendTx}"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"label":"Cancel 1 pending (20 SAT)"},"timeoutMs":30000},
    {"action":"screenshot","name":"transactions"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Cancel 1 pending (20 SAT)"}}],"until":{"label":"No transactions found"},"attempts":4,"settleMs":8000},
    {"action":"assert","that":"notVisible","selector":{"id":"transaction-send-${sendTx}"}},
    {"action":"screenshot","name":"transactions"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
