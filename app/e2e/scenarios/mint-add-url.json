{
  "version": 1,
  "id": "mint.add.url",
  "name": "Add mint manually via URL",
  "description": "From the receive-flow mint selector, open Add Mints, type the testnut URL, check the validated row, confirm, back out to wallet, then reopen the selector to prove testnut persisted and is selectable; ends on wallet",
  "lane": "simulator",
  "tags": ["flow:mint","check:mint-add"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tap","selector":{"id":"wallet-receive"}},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive"},
    {"action":"tap","selector":{"id":"receive-method-fixedAmount"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-amount","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"amount-mint-selector"}},
    {"action":"waitFor","selector":{"id":"mint-select-add"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":45000},
    {"action":"tap","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-confirm"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":60000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tap","selector":{"id":"wallet-receive"}},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"tap","selector":{"id":"receive-method-fixedAmount"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tap","selector":{"id":"amount-mint-selector"}},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"id":"contact-row:mint:https://testnut.cashu.space"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"assert","that":"visible","selector":{"id":"amount-mint-selector"}},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
