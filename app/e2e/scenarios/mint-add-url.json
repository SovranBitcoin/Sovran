{
  "version": 1,
  "id": "mint.add.url",
  "name": "Add a mint by typing its web address",
  "description": "Adds a new mint by typing its web address into the mint list, then reopens the list to prove it was saved and can be selected.",
  "details": "From the wallet header mint pill, open the mint selector, add testnut via the header add button and keyboard URL entry, return home, then reopen the selector to prove testnut persisted and select it; ends on wallet",
  "lane": "simulator",
  "tags": ["flow:mint","check:mint-add"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"mint-select","stable":true,"tolerance":0.001},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-select-add"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-search-toggle"}}],"until":{"id":"mint-add-search-input"},"attempts":4,"settleMs":6000},
    {"action":"input","selector":{"id":"mint-add-search-input"},"value":"https://testnut.cashu.space"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://testnut.cashu.space"}}],"until":{"label":"Add (1)"},"attempts":4,"settleMs":4000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"waitFor","selector":{"id":"mint-add-confirm"},"state":"enabled","timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-confirm"}}],"until":{"id":"e2e-toast-mints-added"},"attempts":4,"settleMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"mint-add-confirm"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"mint-select-add"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tap","selector":{"label":"Cancel"}},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://testnut.cashu.space"},"timeoutMs":30000},
    {"action":"screenshot","name":"mint-select"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://testnut.cashu.space"}}],"until":{"id":"wallet-selected-mint:testnut.cashu.space"},"attempts":4,"settleMs":6000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-mint-selector"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
