{
  "version": 1,
  "id": "theme.wallpaper.relaunch",
  "name": "Apply a wallpaper (survives restarting the app)",
  "description": "Applies a wallpaper from the gallery, then fully closes and reopens the app. The same wallpaper is still showing after the restart instead of resetting to the default.",
  "details": "Apply the Artemis II Collection wallpaper (the proven gallery flow incl. the image-decode probe), then cold-relaunch the app with reset:none: the persisted theme selection must rehydrate — the wallet comes back with the exact album slug AND a decoded, painted wallpaper image, never the none fallback (regression guard for the persisted whole-blob-discard class on the theme store)",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation","check:persistence"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"waitFor","selector":{"id":"wallet-wallpaper:none"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-theme"}}],"until":{"id":"theme-preview-theme-button"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"id":"theme-preview-theme-button"}},
    {"action":"waitFor","selector":{"id":"album-card-artemis-ii-collection"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"album-card-artemis-ii-collection"}},
    {"action":"waitFor","selector":{"id":"theme-apply"},"timeoutMs":30000},
    {"action":"screenshot","name":"theme-preview"},
    {"action":"tap","selector":{"id":"theme-apply"}},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"id":"wallet-wallpaper:artemis-ii-collection"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"wallet-wallpaper-image:loaded"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"},
    {"action":"launch","reset":"none"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":15000},
    {"action":"waitFor","selector":{"id":"wallet-wallpaper:artemis-ii-collection"},"timeoutMs":30000},
    {"action":"waitFor","selector":{"id":"wallet-wallpaper-image:loaded"},"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"wallet-wallpaper:none"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"assert","that":"visible","selector":{"id":"wallet-wallpaper:artemis-ii-collection"}},
    {"action":"assert","that":"visible","selector":{"id":"wallet-wallpaper-image:loaded"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
