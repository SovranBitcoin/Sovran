{
  "version": 1,
  "id": "ai.history.empty",
  "name": "Open AI conversation history as a new user (empty)",
  "description": "A brand-new user opens the AI assistant and taps the conversation history button. The menu opens, correctly shows there are no conversations yet, and closes cleanly without breaking anything.",
  "details": "From the drawer's AI tab, the header-right clock (now AX-reachable via ai-history-button) opens the Conversations picker sheet; for a brand-new user it holds only the disabled 'No conversations yet' row, proving the history affordance is reachable and renders without crash. Dismissed without selecting, ending on the wallet at ₿0",
  "lane": "simulator",
  "tags": ["flow:wallet","check:empty-state","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-ai"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-ai"}},{"delayMs":1200},{"tap":{"id":"tab-ai"}}],"until":{"id":"ai-model-chip"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"ai-model-chip"},"timeoutMs":45000},
    {"action":"screenshot","name":"ai"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"ai-history-button"}}],"until":{"id":"picker-sheet"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"visible","selector":{"id":"ai-sessions-empty"}},
    {"action":"screenshot","name":"picker"},
    {"action":"tap","selector":{"id":"picker-sheet-close"}},
    {"action":"waitFor","selector":{"id":"ai-model-chip"},"timeoutMs":30000},
    {"action":"assert","that":"notVisible","selector":{"id":"picker-sheet"}},
    {"action":"screenshot","name":"ai"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
