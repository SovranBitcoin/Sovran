{
  "version": 1,
  "id": "wallet.currency.display",
  "name": "Show the balance in pounds and euros",
  "description": "With 200 sats in the wallet, the displayed currency is switched to British pounds and then euros, checking that a converted value appears with the right currency symbol each time before switching back to dollars.",
  "details": "Fund 200 at Sovran so the fiat conversion pill shows a real value, switch the display currency to GBP then EUR via the pill's native menu, and capture the wallet with each symbol; no exact-conversion assert because the BTC price is live. Native iOS rows and Android's app menu share the stable spoken names USD/EUR/GBP, while wallet-fiat-currency:<code> proves every selection before capture",
  "lane": "funded",
  "tags": ["flow:wallet","check:fiat-unit"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.cashu","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":200}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-200"}
  ],
  "steps": [
    {"action":"waitFor","selector":{"id":"wallet-fiat-pill"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-fiat-pill"}}],"until":{"label":"GBP"},"attempts":6,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"GBP"}}],"until":{"id":"wallet-fiat-currency:gbp"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-fiat-pill"}}],"until":{"label":"EUR"},"attempts":6,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"EUR"}}],"until":{"id":"wallet-fiat-currency:eur"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-fiat-pill"}}],"until":{"label":"USD"},"attempts":6,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"USD"}}],"until":{"id":"wallet-fiat-currency:usd"},"attempts":4,"settleMs":6000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 200"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
