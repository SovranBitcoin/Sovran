{
  "version": 1,
  "id": "fault.melt.wrong-shape-200",
  "name": "Mint replies with garbage during a payment — money stays safe",
  "description": "While paying a Lightning invoice, the mint sends back a nonsense reply instead of a real answer. The wallet treats the outcome as uncertain rather than guessing, later confirms with the mint that nothing was paid, and the full balance is restored.",
  "details": "Fund 20 testnut sats (net 19), real 10-sat melt quote, then POST /v1/melt/bolt11 answers 200 with an empty JSON object: a wrong-shaped success could be a mangled real success, so it must be treated as ambiguous — no blind restore; after the rule clears the real quote poll confirms UNPAID and the balance restores to exactly 19 (delta 0)",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","amount:fixed","outcome:rolled-back","check:mint-fault","check:fault-tbd"],
  "requires": ["fresh-install","cocod.send.cashu","cocod.receive.bolt11","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":20}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-testnut-20"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"id":"melt-pay"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"melt-pay"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"meltTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${meltTx}","direction":"out","amount":10,"unit":"sat","mintHost":"testnut.cashu.space","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"mintFaults","rules":[{"id":"melt-exec-garbage","mint":"https://testnut.cashu.space","path":"/v1/melt/bolt11","method":"POST","ws":"pass","response":{"mode":"httpStatus","status":200,"body":"{}"}}]},
    {"action":"tap","selector":{"id":"melt-pay"}},
    {"action":"screenshot","name":"lightning-send"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"melt-exec-garbage","minCount":1},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 18"},"timeoutMs":180000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0,"feeEnvelopeSats":1},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
