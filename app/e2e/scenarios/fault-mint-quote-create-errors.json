{
  "version": 1,
  "lane": "simulator",
  "requires": ["fresh-install","mock.mint-faults","unit.sat"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet",
  "id": "fault.mint-quote.create-errors",
  "name": "Asking for a top-up invoice — each mint error gets the right message",
  "description": "Asks the mint for a Lightning invoice for topping up, three times, with the mint failing differently each time. The wallet shows a 'could not connect' message when the mint appears to be down, and the mint's own explanation when the mint refuses the request.",
  "details": "Three invoice-creation attempts against a faulted default mint: (1) bare 500 → mint-unreachable popup (5xx is the offline class), (2) 400 {20003 minting disabled} → general-error popup with the mint's detail (a protocol error is NOT unreachable), (3) 429 rate-limited → general-error popup (429 < 500 is deliberately not the offline class). Documents the error-classification contract at the closest user surface",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","check:mint-fault","check:toast"],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"mintFaults","rules":[{"id":"quote-500","mint":"*","path":"/v1/mint/quote/bolt11","method":"POST","ws":"pass","response":{"mode":"httpStatus","status":500,"body":"Internal Server Error"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Receive"}}],"until":{"label":"Fixed Amount"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Fixed Amount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:100"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"id":"e2e-toast-mint-unreachable"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"quote-500","minCount":1},
    {"action":"mintFaults","rules":[{"id":"quote-20003","mint":"*","path":"/v1/mint/quote/bolt11","method":"POST","ws":"pass","response":{"mode":"error","code":20003,"detail":"Minting is disabled"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Receive"}}],"until":{"label":"Fixed Amount"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Fixed Amount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:100"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"id":"e2e-toast-general-error"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"quote-20003","minCount":1},
    {"action":"mintFaults","rules":[{"id":"quote-429","mint":"*","path":"/v1/mint/quote/bolt11","method":"POST","ws":"pass","response":{"mode":"httpStatus","status":429,"body":"rate limit exceeded"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Receive"}}],"until":{"label":"Fixed Amount"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Fixed Amount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:100"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":6,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"id":"e2e-toast-general-error"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-amount"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"quote-429","minCount":1},
    {"action":"mintFaults","rules":[]}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"screenshot","name":"wallet"}
  ]
}
