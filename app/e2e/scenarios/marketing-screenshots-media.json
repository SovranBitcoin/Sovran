{
  "version": 1,
  "id": "marketing.screenshots.media",
  "name": "Marketing media screenshots",
  "description": "Marketing media screenshots in Mock Mode; captures only, no payments or publishing.",
  "details": "Mock Mode only. Opens an isolated thread target from the retained public snapshot and a fictional Maya story with a bundled Artemis II video. Both reuse production renderers. No live thread reads, cache seeding, composer or publishing. Waits for decoded image/video before capturing. Disabling Mock Mode removes fixture content. Image-overlay capture is separate from these two canonical pages.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"id":"settings-version-row"},"attempts":6,"settleMs":1500},
    {"action":"swipe","dir":"up"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"}
  ],
  "steps": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"openUrl","url":"sovran:///(user-flow)/thread?eventId=dd16895574a90bc50ec19ea2740c4f9f9c8d570c9d931e8e17d4c2b5bdc6b572&preview=demo"},
    {"action":"waitFor","selector":{"id":"demo-thread-ready"},"timeoutMs":45000},
    {"action":"screenshot","name":"thread","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"openUrl","url":"sovran:///(stories-flow)/stories?preview=demo"},
    {"action":"waitFor","selector":{"id":"story-video-ready"},"timeoutMs":45000},
    {"action":"screenshot","name":"stories","delayMs":1200},
    {"action":"tapUntil","sequence":[{"tap":{"id":"story-close"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":4000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"1","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-mint-demo-"}},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-send-demo-"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"label":"kelbie"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"demo-feed-ready"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
