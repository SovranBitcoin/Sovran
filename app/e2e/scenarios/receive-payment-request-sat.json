{
  "version": 1,
  "id": "receive.payment-request.sat",
  "name": "Receive money via a payment request",
  "description": "The wallet displays its standing payment request, and our test partner wallet pays it 25 sats by delivering the ecash over a private direct message. The wallet redeems it automatically, shows a confirmation, and the balance lands on 25 sats.",
  "details": "The QR display Cashu tab shows the wallet's standing NUT-18 payment request; the copy button captures the creq, and the harness pays it the only way the transport allows — cocod mints a 25-sat Sovran token and the harness gift-wraps the NUT-18 payload as a NIP-17 DM to the request's nprofile relays. The app auto-redeems from its gift-wrap inbox (live sub + 15s poll), the confirmed receive toast appears, and the balance lands on 25; sweep to zero",
  "lane": "funded",
  "tags": ["flow:receive","instrument:payment-request","amount:any","io:display","outcome:settled"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat","cocod.receive.cashu"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":25}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"receive"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Cashu"}}],"until":{"id":"receive-creq-p2pk-state"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state"},"timeoutMs":45000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tap","selector":{"id":"receive-copy"}},
    {"action":"capture","as":"creq","fromClipboard":true},
    {"action":"counterparty","operation":"paymentRequest.pay","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":25,"request":"${creq}","timeoutMs":60000},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":90000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 25"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":25},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
