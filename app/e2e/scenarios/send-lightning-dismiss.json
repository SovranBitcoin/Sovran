{
  "version": 1,
  "id": "send.lightning.dismiss",
  "name": "Pay a Lightning invoice (backed out before paying)",
  "description": "Opens a 40-sat Lightning invoice ready to pay, then cancels instead of paying. No money moves and nothing shows up in the wallet's payment history.",
  "details": "Fund 100 sat, open a controlled unpaid 40 sat invoice, cancel the synthetic preview without paying, prove no balance moved and no melt row entered wallet history, then sweep the untouched funds",
  "lane": "funded",
  "tags": ["flow:send","instrument:bolt11","io:paste","outcome:dismissed"],
  "requires": ["fresh-install","cocod.send.bolt11","cocod.receive.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":100}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"},
    {"use":"flow.fund-lightning-100"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.create","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":40,"captureAs":"invoice","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"label":"Paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Paste"}}],"until":{"id":"melt-pay"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"previewTx"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${previewTx}","direction":"out","amount":40,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"waitFor","selector":{"id":"melt-cancel"},"timeoutMs":30000},
    {"action":"screenshot","name":"lightning-send","stable":true,"tolerance":0.001},
    {"action":"tap","selector":{"id":"melt-cancel"}}
  ],
  "verify": [
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":60000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-mint-"},"timeoutMs":30000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-melt-"},"timeoutMs":3000},
    {"action":"screenshot","name":"wallet","stable":true,"tolerance":0.001}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
