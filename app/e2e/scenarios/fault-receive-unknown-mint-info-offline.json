{
  "version": 1,
  "id": "fault.receive.unknown-mint-info-offline",
  "name": "Receiving ecash from an unknown mint that is offline",
  "description": "The wallet is handed 10 sats of ecash from a mint it has never seen before, but that mint is unreachable. Since the wallet can't look the mint up, it fails visibly without crashing, credits nothing, and doesn't quietly add the unknown mint to its list.",
  "details": "cocod mints a 10-sat testnut token the wallet has never seen, then the WHOLE testnut mint is killed before pasting: the token parses locally and the redeem routes toward the mint-trust review, but mint info can never load — the flow must fail or hold visibly without crashing, nothing may be credited, and no half-trusted mint may persist. After the rule clears the wallet is still at zero (delta 0). Documents the current unknown-mint-offline surface",
  "lane": "funded",
  "tags": ["flow:receive","instrument:cashu-token","io:paste","outcome:dismissed","check:mint-fault","check:fault-tbd"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":10}]},
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":10,"captureAs":"incomingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"mintFaults","rules":[{"id":"unknown-mint-offline","mint":"https://testnut.cashu.space","path":"/","ws":"down","response":{"mode":"offline"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-paste"}}],"until":{"label":"Allow Paste"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"screenshot","name":"receive-token"},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"unknown-mint-offline","minCount":1,"timeoutMs":60000},
    {"action":"delay","ms":5000,"reason":"hold window: trust review must fail or hold visibly, never crash"},
    {"action":"screenshot","name":"receive-token"},
    {"action":"assert","that":"notVisible","selector":{"id":"payment-status-receive-confirmed"}},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":30000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
