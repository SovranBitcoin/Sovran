{
  "version": 1,
  "id": "wallet.offline.nostr",
  "name": "Social screens stay usable with no internet connection",
  "description": "With no internet connection, the feed, contacts, and notifications screens can still be opened and moved between without crashing, with the offline banner shown on each. When the connection returns, the banner clears.",
  "details": "Fresh wallet goes into REAL airplane mode (banner barrier passed), then walks the drawer's social routes — Feed (For You), Contacts, Notifications — proving each still navigates and renders with the offline banner overlaid rather than crashing or trapping the user. Screenshots DOCUMENT the current product gap: these screens have no offline empty-state (they degrade to spinners/empty lists), so the evidence frames are the record of today's behavior until an offline state ships. Drawer legs copied verbatim from drawer.navigation; AI and signer-hub are out of scope",
  "lane": "simulator",
  "tags": ["flow:wallet","check:offline","check:navigation"],
  "requires": ["fresh-install","device.network"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"network","mode":"airplane"},
    {"action":"waitFor","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"drawer"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"For You"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"screenshot","name":"feed"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-contacts"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-contacts"}}],"until":{"id":"screen-contacts"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"screen-contacts"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"screenshot","name":"contacts"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-notifications"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-notifications"}}],"until":{"id":"screen-notifications"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"screen-notifications"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"screenshot","name":"notifications"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"network","mode":"online"},
    {"action":"assert","that":"notVisible","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"network","mode":"online"},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
