{
  "version": 1,
  "id": "marketing.screenshots.mints",
  "name": "Marketing mint trust screenshots",
  "description": "Marketing mint trust screenshots in Mock Mode; captures only, no payments or publishing.",
  "details": "LIVE DATA REQUIRED: mint-reviews needs a populated Cuba Bitcoin review corpus; notification-mint-changes needs live changes for that mint. Mock Mode does not invent reviews, trust, or mint updates. A missing readiness signal must fail capture; never retain an empty/loading state as populated evidence. Both iOS and Android: --evidence screenshots --no-record. Captures are presentation evidence only.",
  "lane": "simulator",
  "tags": ["flow:wallet","check:navigation"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.fresh-install"},
    {"action":"waitFor","selector":{"label":"Get Started"},"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"id":"wallet-send"},"attempts":4,"settleMs":8000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"id":"e2e-toast-dev-mode"},"attempts":4,"settleMs":4000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"transaction-"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-mint-selector"}}],"until":{"id":"mint-select-add"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"contact-row:mint:https://mint.macadamia.cash"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"contact-row:mint:https://mint.macadamia.cash"}}],"until":{"id":"wallet-selected-mint:mint.macadamia.cash"},"attempts":4,"settleMs":6000}
  ],
  "steps": [
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"tap","selector":{"id":"wallet-mint-selector"}},
    {"action":"waitFor","selector":{"id":"mint-select-add"},"timeoutMs":45000},
    {"action":"tap","selector":{"id":"mint-inspect:https://mint.cubabitcoin.org"}},
    {"action":"waitFor","selector":{"id":"mint-info-close"},"timeoutMs":45000},
    {"action":"tap","selector":{"id":"mint-info-reviews"}},
    {"action":"waitFor","selector":{"id":"mint-reviews-summary"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"mint-reviews-row-"},"timeoutMs":90000},
    {"action":"screenshot","name":"mint-reviews","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"openUrl","url":"sovran:///(drawer)/(tabs)/notifications/mint-changes?mintUrl=https%3A%2F%2Fmint.cubabitcoin.org"},
    {"action":"waitFor","selector":{"id":"mint-changes-detail"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"idPrefix":"mint-change-revision-"},"timeoutMs":90000},
    {"action":"screenshot","name":"notification-mint-changes","delayMs":1200},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-mode-toggle"},"value":"1","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-mode-toggle"}}],"until":{"id":"settings-mock-mode-toggle"},"untilValue":"0","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-mint-demo-"}},
    {"action":"assert","that":"notVisible","selector":{"idPrefix":"transaction-send-demo-"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-feed"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"label":"kelbie"}},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-feed"}}],"until":{"label":"For You"},"attempts":4,"settleMs":6000},
    {"action":"assert","that":"notVisible","selector":{"id":"demo-feed-ready"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
