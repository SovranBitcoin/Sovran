{
  "version": 1,
  "lane": "funded",
  "requires": ["fresh-install","cocod.send.cashu","unit.sat","mock.mint-faults"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":20}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-testnut-20"}
  ],
  "finally": [
    {"action":"mintFaults","rules":[]},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet",
  "id": "fault.ecash-send.swap-11001",
  "name": "Send fails (mint falsely claims the money was spent) — balance survives",
  "description": "During a send, a misbehaving mint wrongly insists the wallet's money was already spent. The send fails, but the wallet double-checks with the mint and keeps the full balance instead of wiping it.",
  "details": "Fund 20 testnut sats (net 19), make POST /v1/swap answer 400 {11001 proofs already spent} — a LYING mint, since the proofs are genuinely unspent. The send fails, but the wallet must not zero out or quarantine the balance on the mint’s unverified claim: after checkstate reconciliation against the real mint (which reports the proofs UNSPENT once the rule clears), the balance is exactly 19 (delta 0). Response-fake only — NOT real double-spend coverage",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","outcome:rolled-back","check:mint-fault","check:fault-tbd","check:fault-fake-double-spend"],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"mintFaults","rules":[{"id":"swap-11001","mint":"https://testnut.cashu.space","path":"/v1/swap","method":"POST","ws":"pass","response":{"mode":"error","code":11001,"detail":"proofs already spent"}}]},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"1"}}],"until":{"id":"amount-state:1"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"0"}}],"until":{"id":"amount-state:10"},"attempts":4,"settleMs":3000},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"id":"e2e-action-menu-open"},"timeoutMs":30000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"assert","that":"mintFaultIntercepted","ruleId":"swap-11001","minCount":1,"timeoutMs":60000},
    {"action":"delay","ms":3000,"reason":"settle window for any checkstate reconciliation triggered by the spent claim"},
    {"action":"tapAt","x":0.5,"y":0.2},
    {"action":"assert","that":"notVisible","selector":{"id":"e2e-action-menu-open"},"timeoutMs":15000},
    {"action":"mintFaults","rules":[]},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 19"},"timeoutMs":120000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ]
}
