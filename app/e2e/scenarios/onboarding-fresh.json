{
  "version": 1,
  "id": "onboarding.fresh",
  "name": "First-run setup from a clean install",
  "description": "A brand-new install goes through the whole welcome experience — accepting the terms, reading all four intro cards — and lands on the wallet home ready to use.",
  "details": "Splash, terms, all four intro cards (digital cash, profile, privacy, start small) turned with Next, then Get Started on the last card, and wallet home on a factory-clean install.",
  "lane": "simulator",
  "tags": ["flow:onboarding"],
  "requires": ["fresh-install"],
  "setup": [],
  "steps": [
    {"action":"launch","reset":"erase"},
    {"action":"tapAt","x":0.68,"y":0.54},
    {"action":"screenshot","name":"splash","delayMs":2500},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"state":"enabled"},
    {"action":"screenshot","name":"terms"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Continue to Privacy"}}],"until":{"label":"Privacy"},"attempts":4,"settleMs":1000},
    {"action":"screenshot","name":"privacy"},
    {"action":"waitFor","selector":{"id":"privacy-acknowledgment"},"state":"enabled"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"privacy-acknowledgment"}}],"until":{"id":"privacy-acknowledgment"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Confirm and continue"},"state":"enabled"},
    {"action":"tap","selector":{"label":"Confirm and continue"}},
    {"action":"waitFor","selector":{"label":"Small payments on your phone"},"timeoutMs":60000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tap","selector":{"id":"onboarding-next"}},
    {"action":"waitFor","selector":{"label":"Carry your profile with you"},"timeoutMs":30000},
    {"action":"tap","selector":{"id":"onboarding-back"}},
    {"action":"waitFor","selector":{"label":"Small payments on your phone"},"timeoutMs":30000},
    {"action":"tap","selector":{"id":"onboarding-next"}},
    {"action":"waitFor","selector":{"label":"Carry your profile with you"},"timeoutMs":30000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tap","selector":{"id":"onboarding-next"}},
    {"action":"waitFor","selector":{"label":"Understand your privacy"},"timeoutMs":30000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tap","selector":{"id":"onboarding-next"}},
    {"action":"waitFor","selector":{"label":"Start small"},"timeoutMs":30000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"assert","that":"visible","selector":{"id":"onboarding-recovery-phrase"}},
    {"action":"assert","that":"ax","selector":{"label":"Get Started"},"state":{"enabled":true}},
    {"action":"tap","selector":{"label":"Get Started"}}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"No History"},"timeoutMs":60000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [],
  "endState": "wallet"
}
