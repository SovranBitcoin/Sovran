{
  "version": 1,
  "id": "onboarding.fresh",
  "name": "First-run setup from a clean install",
  "description": "A brand-new install goes through the whole welcome experience — accepting the terms, viewing all four intro slides, and the welcome screen — and lands on the wallet home ready to use.",
  "details": "Splash, terms, all four intro slides (bitcoin, nostr, privacy, sovereign), Welcome to Sovran, and wallet home on a factory-clean install. The e2e Metro slows the carousel (EXPO_PUBLIC_E2E_ONBOARDING_SLIDE_MS) and each slide is advanced by tapping it; slide 4 is left un-tapped because its next index is the loop clone of slide 1.",
  "lane": "simulator",
  "tags": ["flow:onboarding"],
  "requires": ["fresh-install"],
  "setup": [],
  "steps": [
    {"action":"launch","reset":"erase"},
    {"action":"tapAt","x":0.68,"y":0.54},
    {"action":"screenshot","name":"splash","delayMs":2500},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"screenshot","name":"terms"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Next"},"state":"enabled"},
    {"action":"tap","selector":{"label":"Next"}},
    {"action":"waitFor","selector":{"label":"Bitcoin that feels like cash"},"timeoutMs":60000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Bitcoin that feels like cash"}}],"until":{"label":"Powered by Nostr"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Powered by Nostr"}}],"until":{"label":"Private by Design"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Private by Design"}}],"until":{"label":"Stay private, stay sovereign"},"attempts":4,"settleMs":6000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"label":"Welcome to Sovran"},"attempts":4,"settleMs":3000},
    {"action":"screenshot","name":"welcome","stable":true,"tolerance":0.01},
    {"action":"assert","that":"ax","selector":{"label":"Get Started"},"state":{"enabled":true}},
    {"action":"tap","selector":{"label":"Get Started"}}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"No History"},"timeoutMs":60000},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [],
  "endState": "wallet"
}
