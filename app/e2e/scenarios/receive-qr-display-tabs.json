{
  "version": 1,
  "id": "receive.qr-display.tabs",
  "name": "Tour every tab of the receive QR screen",
  "description": "Walks through every tab of the standing receive QR screen — the combined code, the Lightning options, the not-yet-available options with their helpful empty screens, and the payment-request tab where locking incoming payments to your own key is switched on. It then adds a mint advertised as supporting reusable Lightning offers, checks which methods the combined code includes, and switches that method off and on before returning to the wallet.",
  "details": "Walk every standing receive rail on the QR display: Unified (default), Lightning with its Address/BOLT 12 pills, the BOLT 12 find-mints empty state (opens the pre-filtered Add Mints screen and returns), the Onchain tab's ready address, and the Cashu payment-request tab where the P2PK lock row is toggled on (state probe flips to 1); ends on wallet. After the empty-state tour, adds the first BOLT 12/sat-filtered Discover result through the normal trust UI, then asserts BOLT 12 is included in Unified (its own copy row and the state probe). Uses the Unified state probe, not the removed method pills. Requires a live discovery result whose mint can create a reusable offer; no payment or funding is performed. P2PK enablement needs a keyring key plus a NUT-11-capable mint",
  "lane": "simulator",
  "tags": ["flow:receive","io:display"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"id":"receive-unified-rails-state"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"id":"receive-unified-copy-creq"}},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Lightning"}}],"until":{"id":"receive-lightning-mode-address"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-lightning-mode-address"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-lightning-mode-offer"}}],"until":{"id":"receive-bolt12-find-mints"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-bolt12-find-mints"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-bolt12-find-mints"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":8000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"mint-add-cancel"}}],"until":{"id":"receive-bolt12-find-mints"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Onchain"}}],"until":{"id":"payment-info-address-data"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"payment-info-address-data"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Cashu"}}],"until":{"id":"receive-creq-p2pk-state"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state"},"timeoutMs":45000},
    {"action":"swipe","dir":"up"},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tap","selector":{"id":"receive-creq-p2pk-toggle"}},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state:1"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"swipe","dir":"down"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Lightning"}}],"until":{"id":"receive-lightning-mode-offer"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-lightning-mode-offer"}}],"until":{"id":"receive-bolt12-find-mints"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-bolt12-find-mints"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"idPrefix":"contact-row:mint:","matchIndex":0,"captureSuffixAs":"unifiedBolt12Mint"},"timeoutMs":45000},
    {"action":"tap","selector":{"id":"contact-row:mint:${unifiedBolt12Mint}"}},
    {"action":"waitFor","selector":{"id":"mint-add-confirm"},"state":"enabled","timeoutMs":15000},
    {"action":"tap","selector":{"id":"mint-add-confirm"}},
    {"action":"waitFor","selector":{"id":"e2e-toast-mints-added"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Unified"}}],"until":{"id":"receive-unified-rails-state"},"attempts":4,"settleMs":8000},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"receive-unified-copy-bolt12"},"timeoutMs":45000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
