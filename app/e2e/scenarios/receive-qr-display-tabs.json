{
  "version": 1,
  "id": "receive.qr-display.tabs",
  "name": "QR display tabs tour",
  "description": "Walk every standing receive rail on the QR display: Unified (default), Lightning with its Address/BOLT 12 pills, the BOLT 12 and Onchain find-mints empty states (each opens the pre-filtered Add Mints screen and returns), and the Cashu payment-request tab where the P2PK lock row is toggled on (state probe flips to 1); ends on wallet. P2PK enablement needs a keyring key plus a NUT-11-capable mint — a first-run hypothesis",
  "lane": "simulator",
  "tags": ["flow:receive","io:display"],
  "requires": ["fresh-install"],
  "setup": [
    {"use":"flow.onboard"}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-qrDisplay"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-qrDisplay"}}],"until":{"id":"receive-copy"},"attempts":4,"settleMs":8000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Lightning"}}],"until":{"id":"receive-lightning-mode-address"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-lightning-mode-address"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tap","selector":{"id":"receive-lightning-mode-offer"}},
    {"action":"waitFor","selector":{"id":"receive-bolt12-find-mints"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-bolt12-find-mints"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":8000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tap","selector":{"id":"mint-add-cancel"}},
    {"action":"waitFor","selector":{"id":"receive-bolt12-find-mints"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Onchain"}}],"until":{"id":"receive-onchain-find-mints"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-onchain-find-mints"},"timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-onchain-find-mints"}}],"until":{"id":"mint-add-search-toggle"},"attempts":4,"settleMs":8000},
    {"action":"screenshot","name":"mint-add"},
    {"action":"tap","selector":{"id":"mint-add-cancel"}},
    {"action":"waitFor","selector":{"id":"receive-onchain-find-mints"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Cashu"}}],"until":{"id":"receive-creq-p2pk-state"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state"},"timeoutMs":45000},
    {"action":"swipe","dir":"up"},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"tap","selector":{"id":"receive-creq-p2pk-toggle"}},
    {"action":"waitFor","selector":{"id":"receive-creq-p2pk-state"},"value":"1","timeoutMs":30000},
    {"action":"screenshot","name":"receive-qr"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
