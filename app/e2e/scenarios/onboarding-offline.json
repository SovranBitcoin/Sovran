{
  "version": 1,
  "id": "onboarding.offline",
  "name": "First-run setup completes with no internet connection",
  "description": "A new user accepts the terms, then loses all connectivity before the intro slides. Setup still completes all the way to the wallet home, because creating a wallet identity happens entirely on the device and needs no network.",
  "details": "Fresh install, accept Terms, then enable REAL airplane mode BEFORE the intro carousel and drive the whole onboarding to the wallet home offline. Keys are generated locally, so identity creation does not need the network; this proves onboarding COMPLETES offline and that the default-mint bootstrap (which does touch the network) does not block reaching the wallet. FLAG (proven this run): the OfflineProvider's YOU ARE OFFLINE banner is NOT rendered during onboarding — OfflineShell wraps only the post-onboarding navigation Stack, so a user onboarding offline gets no offline indication until they reach the wallet, where the banner correctly appears. Uses inline fresh-install legs because flow.onboard cannot have airplane spliced into it",
  "lane": "simulator",
  "tags": ["flow:onboarding","check:offline"],
  "requires": ["fresh-install","device.network"],
  "setup": [],
  "steps": [
    {"action":"launch","reset":"erase"},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"timeoutMs":240000},
    {"action":"waitFor","selector":{"id":"terms-acceptance"},"state":"enabled"},
    {"action":"screenshot","name":"terms"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"terms-acceptance"}}],"until":{"id":"terms-acceptance"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Continue to Privacy"}}],"until":{"label":"Privacy"},"attempts":4,"settleMs":1000},
    {"action":"screenshot","name":"privacy"},
    {"action":"waitFor","selector":{"id":"privacy-acknowledgment"},"state":"enabled"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"privacy-acknowledgment"}}],"until":{"id":"privacy-acknowledgment"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"Confirm and continue"},"state":"enabled","timeoutMs":30000},
    {"action":"tap","selector":{"label":"Confirm and continue"}},
    {"action":"network","mode":"airplane"},
    {"action":"delay","ms":8000,"reason":"let OfflineProvider commit offline (2 checks over >=5s, no banner during onboarding to wait on) before the default-mint bootstrap runs"},
    {"action":"waitFor","selector":{"label":"Bitcoin that feels like cash"},"timeoutMs":60000},
    {"action":"screenshot","name":"onboarding-carousel"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Bitcoin that feels like cash"}}],"until":{"label":"Powered by Nostr"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Powered by Nostr"}}],"until":{"label":"Private by Design"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Private by Design"}}],"until":{"label":"Stay private, stay sovereign"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"swipe":{"dir":"up"}}],"until":{"label":"Welcome to Sovran"},"attempts":4,"settleMs":3000},
    {"action":"screenshot","name":"welcome"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Get Started"}}],"until":{"label":"No History"},"attempts":4,"settleMs":8000},
    {"action":"waitFor","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"screenshot","name":"wallet"},
    {"action":"network","mode":"online"},
    {"action":"assert","that":"notVisible","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000}
  ],
  "verify": [
    {"action":"assert","that":"visible","selector":{"id":"wallet-send"}},
    {"action":"assert","that":"visible","selector":{"id":"wallet-receive"}},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"network","mode":"online"},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
