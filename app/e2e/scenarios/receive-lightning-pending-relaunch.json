{
  "version": 1,
  "id": "receive.lightning.pending-relaunch",
  "name": "Lightning receive survives an app restart, then settles",
  "description": "The wallet creates a 25-sat Lightning invoice, the app is fully closed and reopened while the invoice is still unpaid, and then the invoice gets paid. The wallet still notices the payment after the restart and credits exactly 25 sats, exactly once.",
  "details": "Mint a 25 sat Lightning quote, dismiss the sheet and cold-relaunch the app while the invoice is still UNPAID, then have cocod pay it: the resumed pending-quote watcher must settle the SAME pre-relaunch quote (confirmed toast on the wallet home, View routes to the finalized original transaction, +25 exactly once)",
  "lane": "funded",
  "tags": ["flow:receive","instrument:bolt11","amount:fixed","io:display","outcome:settled","check:interruption","check:toast"],
  "requires": ["fresh-install","cocod.send.bolt11","unit.sat"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":25}]},
  "setup": [
    {"use":"flow.onboard-sovran-mint"}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-fixedAmount"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"receive-method-fixedAmount"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-fixedAmount"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"2"}}],"until":{"id":"amount-state:2"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"5"}}],"until":{"id":"amount-state:25"},"attempts":4,"settleMs":3000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"amount-next"}}],"until":{"id":"e2e-action-menu-open"},"attempts":4,"settleMs":8000},
    {"action":"tapAt","x":0.5,"y":0.905},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"quoteTx"},"timeoutMs":30000},
    {"action":"capture","as":"invoice","fromSelector":{"id":"payment-info-lightning-invoice-data"},"attribute":"label"},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","amount":25,"unit":"sat","mintHost":"mint.sovran.money","status":"UNPAID"},
    {"action":"screenshot","name":"lightning-receive","stable":true,"tolerance":0.001},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"launch","reset":"none"},
    {"action":"waitFor","selector":{"id":"wallet-send"},"timeoutMs":45000},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":15000},
    {"action":"screenshot","name":"wallet"},
    {"action":"counterparty","operation":"bolt11.pay","mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"amount":25,"invoice":"${invoice}","timeoutMs":120000},
    {"action":"waitFor","selector":{"id":"payment-status-receive-confirmed"},"timeoutMs":180000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"payment-status-view"}}],"until":{"id":"transaction-probe-${quoteTx}"},"attempts":4,"settleMs":4000},
    {"action":"waitFor","selector":{"id":"transaction-probe-${quoteTx}"},"timeoutMs":60000},
    {"action":"assert","that":"tx","txRef":"${quoteTx}","direction":"in","amount":25,"unit":"sat","mintHost":"mint.sovran.money","status":"finalized"},
    {"action":"screenshot","name":"lightning-receive"},
    {"action":"goHome"}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 25"},"timeoutMs":60000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":25},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
