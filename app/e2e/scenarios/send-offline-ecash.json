{
  "version": 1,
  "id": "send.offline.ecash",
  "name": "Send ecash with no internet connection",
  "description": "With no internet connection, the wallet can still package its money into an ecash token entirely on the phone. The send shows as waiting, and it is still waiting after the connection comes back — the balance moves into the outgoing ecash and nothing is lost.",
  "details": "CONVERTED to the Android driver's REAL airplane mode. Funded via valueless testnut so this offline-persistence check carries no real-sat custody risk. Then go into real airplane mode and prove cash still works with no network: under the YOU ARE OFFLINE banner, Send-all composes an ecash token entirely from local proofs (no mint round-trip) and the pending outgoing tx is asserted (out/49/pending). Back online the send REMAINS pending — offline-created sends are not auto-reclaimed — so reopened from the wallet list it still shows the full amount pending online; the balance is emptied into the pending token (delta -49). testnut is valueless (auto write-off, no sweep). NOTE: the in-app RECLAIM (cancel via the '...' action menu) is intentionally NOT exercised on Android — a FullWindowOverlay action sheet over the modal tx-detail makes uiautomator dump the wrong window (documented AX limitation); this scenario proves the offline-send + persist-pending core, which is the meaningful offline behavior. The token-screen dump depends on IS_ANDROID_E2E freezing the LoadingIndicator spin / QR fountain / skeleton pulse.",
  "lane": "funded",
  "tags": ["flow:send","instrument:cashu-token","amount:any","io:display","outcome:settled","check:offline"],
  "requires": ["fresh-install","cocod.send.cashu","unit.sat","device.network"],
  "funds": {"assets":[{"mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"action":"counterparty","operation":"cashu.create","mintUrl":"https://testnut.cashu.space","unit":"sat","accountIndex":0,"amount":50,"captureAs":"fundingToken","setClipboard":true,"timeoutMs":60000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"wallet-receive"}}],"until":{"id":"receive-method-paste"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"receive-method-paste"}}],"until":{"id":"receive-token-redeem"},"attempts":4,"settleMs":6000},
    {"action":"tap","selector":{"label":"Allow Paste"},"optional":{"reason":"android has no blocking paste dialog"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"mint-info-trust"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"mint-info-trust"}},
    {"action":"waitFor","selector":{"id":"receive-token-redeem"},"timeoutMs":60000},
    {"action":"tap","selector":{"id":"receive-token-redeem"}},
    {"action":"waitFor","selector":{"id":"receive-token-close"},"timeoutMs":120000},
    {"action":"tap","selector":{"id":"receive-token-close"}},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"₿ 49"},"timeoutMs":60000}
  ],
  "steps": [
    {"action":"screenshot","name":"wallet"},
    {"action":"network","mode":"airplane"},
    {"action":"waitFor","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000},
    {"action":"screenshot","name":"wallet"},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-chip-send-all"},"timeoutMs":15000},
    {"action":"tap","selector":{"id":"amount-chip-send-all"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"label":"Copy"},"timeoutMs":60000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"waitFor","selector":{"idPrefix":"transaction-probe-","captureSuffixAs":"sendTx"},"timeoutMs":30000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":49,"unit":"sat","mintHost":"testnut.cashu.space","status":"pending"},
    {"action":"screenshot","name":"send-token"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"assert","that":"visible","selector":{"label":"YOU ARE OFFLINE"}},
    {"action":"network","mode":"online"},
    {"action":"assert","that":"notVisible","selector":{"label":"YOU ARE OFFLINE"},"timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"transaction-send-${sendTx}"}}],"until":{"id":"payment-info-token-data"},"attempts":4,"settleMs":8000},
    {"action":"assert","that":"tx","txRef":"${sendTx}","direction":"out","amount":49,"unit":"sat","mintHost":"testnut.cashu.space","status":"pending"},
    {"action":"screenshot","name":"send-token"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":-49},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"action":"network","mode":"online"},
    {"use":"flow.return-to-wallet"}
  ],
  "endState": "wallet"
}
