{
  "version": 1,
  "id": "send.mock-fail.ecash",
  "name": "Failed ecash send debits nothing",
  "description": "Fund 50, enable the Mock Fail Send developer switch, and attempt a 10-sat Create Ecash: executeSend fails before prepare (deterministic dev injection) and the app degrades to the offline proof-selector sheet (Choose amount: round up/down from composable local denominations) instead of debiting anything; the sheet is dismissed and the balance stays exactly 50. Proves the send error path leaves no reservation and falls back gracefully",
  "lane": "funded",
  "tags": ["flow:send","instrument:cashu-token","amount:fixed","outcome:rolled-back","check:toast"],
  "requires": ["fresh-install"],
  "funds": {"assets":[{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0,"maxPrincipal":50}]},
  "setup": [
    {"use":"flow.onboard"},
    {"use":"flow.fund-lightning-50","with":{"mintUrl":"https://mint.sovran.money","mintHost":"mint.sovran.money"}}
  ],
  "steps": [
    {"action":"tapUntil","sequence":[{"tap":{"id":"header-profile-avatar"}}],"until":{"id":"drawer-menu-settings"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"drawer-menu-settings"}}],"until":{"label":"ACCOUNT"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"label":"ACCOUNT"},"timeoutMs":30000},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-version-row"},"timeoutMs":15000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}},{"tap":{"id":"settings-version-row"}}],"until":{"label":"Developer mode enabled"},"attempts":2,"settleMs":1500},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"swipe","dir":"up"},
    {"action":"waitFor","selector":{"id":"settings-mock-fail-send-toggle"},"value":"0","timeoutMs":20000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"settings-mock-fail-send-toggle"}}],"until":{"id":"settings-mock-fail-send-toggle"},"untilValue":"1","attempts":4,"settleMs":6000},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000},
    {"action":"tapUntil","sequence":[{"tap":{"label":"Send"}}],"until":{"id":"send-method-createEcash"},"attempts":4,"settleMs":6000},
    {"action":"tapUntil","sequence":[{"tap":{"id":"send-method-createEcash"}}],"until":{"id":"amount-next"},"attempts":4,"settleMs":6000},
    {"action":"waitFor","selector":{"id":"amount-next"},"timeoutMs":30000},
    {"action":"tap","selector":{"label":"1"}},
    {"action":"tap","selector":{"label":"0"}},
    {"action":"waitFor","selector":{"id":"amount-next"},"state":"enabled","timeoutMs":15000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tap","selector":{"id":"amount-next"}},
    {"action":"waitFor","selector":{"id":"e2e-action-menu-open"},"timeoutMs":20000},
    {"action":"screenshot","name":"send-amount"},
    {"action":"tapAt","x":0.5,"y":0.2},
    {"action":"delay","ms":2000,"reason":"proof-selector sheet dismissal exposes no AX signal"},
    {"action":"screenshot","name":"send-amount"},
    {"action":"goHome"},
    {"action":"waitFor","selector":{"label":"Split"},"timeoutMs":45000}
  ],
  "verify": [
    {"action":"waitFor","selector":{"label":"₿ 50"},"timeoutMs":30000},
    {"action":"assert","that":"balanceDelta","unit":"sat","delta":0},
    {"action":"screenshot","name":"wallet"}
  ],
  "finally": [
    {"use":"flow.sweep-mint","with":{"mintUrl":"https://mint.sovran.money","unit":"sat","accountIndex":0}},
    {"use":"flow.return-to-wallet"},
    {"action":"waitFor","selector":{"label":"₿ 0"},"timeoutMs":45000}
  ],
  "endState": "wallet"
}
