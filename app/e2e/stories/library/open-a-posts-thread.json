{
  "id": "open-a-posts-thread",
  "purpose": "A person opens a post from the design system's sample posts and sees its thread, with the box to reply.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down to the end",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.6
      },
      "expect": [
        {
          "visible": {
            "id": "settings-version-row"
          }
        }
      ]
    },
    {
      "name": "press the version, once",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, twice",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, three times",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the developer rows",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.5
      },
      "expect": [
        {
          "visible": {
            "id": "settings-design-system-row"
          }
        }
      ]
    },
    {
      "name": "open the design system",
      "tap": {
        "id": "settings-design-system-row"
      },
      "expect": [
        {
          "page": "SettingsDesignSystemScreen"
        },
        {
          "visible": {
            "id": "design-system-screens-row"
          }
        },
        {
          "visible": {
            "id": "design-system-flow-send"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "scroll",
      "swipe": {
        "on": {
          "id": "design-system-flow-send"
        },
        "direction": "up",
        "distance": 0.38
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-family-headers"
          }
        }
      ]
    },
    {
      "name": "scroll again",
      "swipe": {
        "on": {
          "id": "screen-settings-design-system"
        },
        "direction": "up",
        "distance": 0.5
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-family-fake-posts"
          }
        }
      ]
    },
    {
      "name": "fake posts",
      "tap": {
        "id": "design-system-family-fake-posts"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-scenario-fake-posts-text-baseline"
          }
        }
      ],
      "withinMs": 15000
    },
    {
      "name": "open the plain post",
      "tap": {
        "id": "design-system-scenario-fake-posts-text-baseline"
      },
      "expect": [
        {
          "page": "ThreadScreen"
        },
        {
          "visible": {
            "id": "thread-reply-input"
          }
        },
        {
          "visible": {
            "id": "post-zap"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "close the thread",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "gone": {
            "id": "thread-reply-input"
          }
        },
        {
          "visible": {
            "id": "design-system-scenario-fake-posts-text-baseline"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
