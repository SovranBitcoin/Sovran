{
  "id": "the-app-says-when-it-is-offline",
  "purpose": "A person whose phone has lost its connection (pretended here from the developer rows) sees a banner saying the app is offline, on the wallet and on Send.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.6
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the very end",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.3
      },
      "expect": [
        {
          "visible": {
            "id": "settings-version-row"
          }
        }
      ]
    },
    {
      "name": "press the version, once",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, twice",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, three times",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the developer rows",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.8
      },
      "expect": [
        {
          "visible": {
            "id": "settings-mock-mode-toggle"
          }
        }
      ]
    },
    {
      "name": "pretend to be offline, and let the notice over the header go",
      "tap": {
        "id": "settings-mock-offline-toggle"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-mock-offline-toggle"
          }
        },
        {
          "gone": {
            "label": "Developer mode enabled"
          }
        },
        {
          "logged": "store.settings.set_mock_offline",
          "with": {
            "enabled": true
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "close Settings",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "visible": {
            "id": "offline-banner"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open Send",
      "tap": {
        "id": "wallet-send"
      },
      "expect": [
        {
          "visible": {
            "id": "send-method-createEcash"
          }
        },
        {
          "visible": {
            "id": "offline-banner"
          }
        }
      ]
    }
  ]
}
