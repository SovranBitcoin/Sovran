{
  "id": "look-for-people-nearby",
  "purpose": "A person opens Nut Drop and then the list of people nearby, which is empty with nobody around.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Receive",
      "tap": {
        "id": "wallet-receive"
      },
      "expect": [
        {
          "visible": {
            "id": "receive-method-nutDrop"
          }
        }
      ]
    },
    {
      "name": "open Nut Drop",
      "tap": {
        "id": "receive-method-nutDrop"
      },
      "expect": [
        {
          "page": "NearPayScreen"
        },
        {
          "visible": {
            "id": "near-pay-peers"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open the nearby list",
      "tap": {
        "id": "near-pay-peers"
      },
      "expect": [
        {
          "visible": {
            "id": "screen-near-pay-peer-list"
          }
        },
        {
          "gone": {
            "id": "near-pay-peers"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
