{
  "id": "walk-the-design-system-flows",
  "purpose": "A person opens the variations, the prompts and each sample flow of the design system in turn and comes back to the list.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.6
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the very end",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.3
      },
      "expect": [
        {
          "visible": {
            "id": "settings-version-row"
          }
        }
      ]
    },
    {
      "name": "press the version, once",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, twice",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, three times",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the developer rows",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.5
      },
      "expect": [
        {
          "visible": {
            "id": "settings-design-system-row"
          }
        }
      ]
    },
    {
      "name": "open the design system",
      "tap": {
        "id": "settings-design-system-row"
      },
      "expect": [
        {
          "page": "SettingsDesignSystemScreen"
        },
        {
          "visible": {
            "id": "design-system-screens-row"
          }
        },
        {
          "visible": {
            "id": "design-system-flow-send"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open variations",
      "tap": {
        "id": "design-system-variations-row"
      },
      "expect": [
        {
          "gone": {
            "id": "design-system-variations-row"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "back from variations",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-variations-row"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open prompts",
      "tap": {
        "id": "design-system-prompts-row"
      },
      "expect": [
        {
          "gone": {
            "id": "design-system-prompts-row"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "back from prompts",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-prompts-row"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open flow send",
      "tap": {
        "id": "design-system-flow-send"
      },
      "expect": [
        {
          "gone": {
            "id": "design-system-flow-send"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "back from flow send",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-flow-send"
          }
        },
        {
          "logged": "ui.touch"
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open flow receive",
      "tap": {
        "id": "design-system-flow-receive"
      },
      "expect": [
        {
          "gone": {
            "id": "design-system-flow-receive"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "back from flow receive",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-flow-receive"
          }
        },
        {
          "logged": "ui.touch"
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open flow transactions",
      "tap": {
        "id": "design-system-flow-transactions"
      },
      "expect": [
        {
          "gone": {
            "id": "design-system-flow-transactions"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "back from flow transactions",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "visible": {
            "id": "design-system-flow-transactions"
          }
        },
        {
          "logged": "ui.touch"
        }
      ],
      "withinMs": 10000
    }
  ]
}
