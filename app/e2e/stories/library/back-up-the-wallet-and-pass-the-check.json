      "expect": [
        {
          "visible": {
            "label": "5 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 5",
      "tap": {
        "labelEnds": ", {{word5}}"
      },
      "expect": [
        {
          "visible": {
            "label": "6 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 6",
      "tap": {
        "labelEnds": ", {{word6}}"
      },
      "expect": [
        {
          "visible": {
            "label": "7 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 7",
      "tap": {
        "labelEnds": ", {{word7}}"
      },
      "expect": [
        {
          "visible": {
            "label": "8 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 8",
      "tap": {
        "labelEnds": ", {{word8}}"
      },
      "expect": [
        {
          "visible": {
            "label": "9 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 9",
      "tap": {
        "labelEnds": ", {{word9}}"
      },
      "expect": [
        {
          "visible": {
            "label": "10 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 10",
      "tap": {
        "labelEnds": ", {{word10}}"
      },
      "expect": [
        {
          "visible": {
            "label": "11 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 11",
      "tap": {
        "labelEnds": ", {{word11}}"
      },
      "expect": [
        {
          "visible": {
            "label": "12 of 12"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "pick word 12",
      "tap": {
        "labelEnds": ", {{word12}}"
      },
      "expect": [
        {
          "visible": {
            "id": "backup-done-button"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "finish",
      "tap": {
        "id": "backup-done-button"
      },
      "expect": [
        {
          "gone": {
            "id": "backup-done-button"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
