{
  "id": "make-notifications-strict",
  "purpose": "A person changes who can notify them from Relaxed to Strict, and Settings shows the new choice.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "open Notifications",
      "tap": {
        "id": "settings-notifications-row"
      },
      "expect": [
        {
          "page": "SettingsNotificationPolicyScreen"
        },
        {
          "visible": {
            "id": "notification-policy-strict"
          }
        }
      ]
    },
    {
      "name": "choose Strict",
      "tap": {
        "id": "notification-policy-strict"
      },
      "expect": [
        {
          "visible": {
            "id": "notification-policy-strict"
          }
        }
      ]
    },
    {
      "name": "go back to Settings",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "visible": {
            "label": "Notifications, Strict"
          }
        },
        {
          "gone": {
            "id": "notification-policy-strict"
          }
        }
      ]
    }
  ]
}
