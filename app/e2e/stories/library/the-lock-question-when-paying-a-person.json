{
  "id": "the-lock-question-when-paying-a-person",
  "purpose": "A person enters someone's public key in Send, an amount, chooses ecash, and is asked whether to lock the ecash to that person.",
  "startsFrom": "pick-the-notes-to-send",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Send",
      "tap": {
        "id": "wallet-send"
      },
      "expect": [
        {
          "visible": {
            "id": "send-destination-input"
          }
        }
      ]
    },
    {
      "name": "type their public key",
      "type": {
        "into": {
          "id": "send-destination-input"
        },
        "text": "npub1ref7jqxrh0z74554y900ufajer2lh52lk0wczrdrqcm8fjmjzweqll64x3"
      },
      "expect": [
        {
          "visible": {
            "id": "send-detected-person"
          }
        }
      ],
      "withinMs": 25000
    },
    {
      "name": "choose to pay them",
      "tap": {
        "id": "send-detected-person"
      },
      "expect": [
        {
          "page": "AmountFlowScreen"
        },
        {
          "visible": {
            "label": "Pay Sovran"
          }
        },
        {
          "visible": {
            "id": "keypad-key-5"
          }
        }
      ],
      "withinMs": 15000
    },
    {
      "name": "press 5",
      "tap": {
        "id": "keypad-key-5"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 5 sat"
          }
        }
      ]
    },
    {
      "name": "press Next",
      "tap": {
        "id": "amount-next"
      },
      "expect": [
        {
          "visible": {
            "id": "amount-next-menu-ecash"
          }
        },
        {
          "visible": {
            "id": "amount-next-menu-lightning"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "choose ecash, and be asked about locking it",
      "tap": {
        "id": "amount-next-menu-ecash"
      },
      "expect": [
        {
          "visible": {
            "id": "send-lock-off"
          }
        },
        {
          "visible": {
            "id": "send-lock-forever"
          }
        },
        {
          "gone": {
            "id": "amount-next-menu-lightning"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
