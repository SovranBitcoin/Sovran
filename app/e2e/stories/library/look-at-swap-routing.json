{
  "id": "look-at-swap-routing",
  "purpose": "A person opens Swap routing in Settings and sees the limits the wallet uses when it moves money between mints, then goes back.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "open Swap routing",
      "tap": {
        "id": "settings-routing-row"
      },
      "expect": [
        {
          "page": "SettingsRoutingScreen"
        },
        {
          "visible": {
            "id": "settings-routing-min-transfer"
          }
        },
        {
          "visible": {
            "id": "settings-routing-max-hops"
          }
        },
        {
          "visible": {
            "id": "settings-routing-max-fee"
          }
        }
      ]
    },
    {
      "name": "go back to Settings",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-routing-row"
          }
        },
        {
          "gone": {
            "id": "settings-routing-max-fee"
          }
        }
      ]
    }
  ]
}
