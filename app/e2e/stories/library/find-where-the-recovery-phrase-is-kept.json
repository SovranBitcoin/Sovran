{
  "id": "find-where-the-recovery-phrase-is-kept",
  "purpose": "A person opens Profile and keys in Settings and finds the warning about their keys, the backup, and their recovery phrase still hidden.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "open Profile and keys",
      "tap": {
        "id": "settings-profile-row"
      },
      "expect": [
        {
          "page": "SettingsProfileScreen"
        },
        {
          "visible": {
            "id": "settings-keys-warning"
          }
        },
        {
          "visible": {
            "id": "settings-backup-row"
          }
        },
        {
          "visible": {
            "id": "profile-reveal-mnemonic"
          }
        }
      ]
    },
    {
      "name": "go back to Settings",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-profile-row"
          }
        },
        {
          "gone": {
            "id": "settings-keys-warning"
          }
        }
      ]
    }
  ]
}
