{
  "id": "open-remote-login",
  "purpose": "A person opens Remote Login from the drawer and sees the ways to connect another app to their key, then closes it.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Remote Login",
      "tap": {
        "id": "drawer-menu-remote-login"
      },
      "expect": [
        {
          "page": "SignerHubScreen"
        },
        {
          "visible": {
            "id": "signer-hub-scan-row"
          }
        },
        {
          "visible": {
            "id": "signer-hub-paste-row"
          }
        },
        {
          "visible": {
            "id": "signer-hub-share-row"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "close it",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "gone": {
            "id": "signer-hub-scan-row"
          }
        },
        {
          "visible": {
            "id": "header-profile-avatar"
          }
        }
      ]
    }
  ]
}
