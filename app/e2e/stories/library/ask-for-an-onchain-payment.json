{
  "id": "ask-for-an-onchain-payment",
  "purpose": "A person asks for 21 sats on-chain and is shown a bitcoin address to pay, with the limits for deposits.",
  "startsFrom": "testnut-mint",
  "steps": [
    {
      "name": "the wallet opens on the test mint",
      "expect": [
        {
          "visible": {
            "id": "wallet-selected-mint:testnut.cashu.space"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Receive",
      "tap": {
        "id": "wallet-receive"
      },
      "expect": [
        {
          "visible": {
            "id": "receive-method-fixedAmount"
          }
        }
      ]
    },
    {
      "name": "ask for a fixed amount",
      "tap": {
        "id": "receive-method-fixedAmount"
      },
      "expect": [
        {
          "visible": {
            "id": "keypad-key-2"
          }
        }
      ]
    },
    {
      "name": "press 2",
      "tap": {
        "id": "keypad-key-2"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 2 sat"
          }
        }
      ]
    },
    {
      "name": "press 1",
      "tap": {
        "id": "keypad-key-1"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 21 sat"
          }
        }
      ]
    },
    {
      "name": "press Next",
      "tap": {
        "id": "amount-next"
      },
      "expect": [
        {
          "visible": {
            "id": "amount-next-menu-ecash"
          }
        }
      ]
    },
    {
      "name": "choose on-chain",
      "tap": {
        "id": "amount-next-menu-onchain"
      },
      "expect": [
        {
          "page": "OnchainReceiveScreen"
        },
        {
          "visible": {
            "id": "payment-info-address-data"
          }
        },
        {
          "visible": {
            "id": "receive-onchain-deposit-limits"
          }
        },
        {
          "visible": {
            "label": "Incoming 21 sat transaction, UNPAID"
          }
        }
      ],
      "withinMs": 15000
    }
  ]
}
