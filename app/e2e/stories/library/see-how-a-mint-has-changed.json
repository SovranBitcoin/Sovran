{
  "id": "see-how-a-mint-has-changed",
  "purpose": "A person opens the update history of the mint their wallet uses and sees what the mint has changed about itself.",
  "startsFrom": "testnut-mint",
  "steps": [
    {
      "name": "the wallet opens on the test mint",
      "expect": [
        {
          "visible": {
            "id": "wallet-selected-mint:testnut.cashu.space"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the mint list",
      "tap": {
        "id": "wallet-mint-selector"
      },
      "expect": [
        {
          "page": "MintListScreen"
        },
        {
          "visible": {
            "id": "mint-currency-tab-TSAT"
          }
        }
      ]
    },
    {
      "name": "show the test mints",
      "tap": {
        "id": "mint-currency-tab-TSAT"
      },
      "expect": [
        {
          "visible": {
            "id": "mint-inspect:https://testnut.cashu.space"
          }
        }
      ]
    },
    {
      "name": "open the mint's page",
      "tap": {
        "id": "mint-inspect:https://testnut.cashu.space"
      },
      "expect": [
        {
          "page": "MintInfoScreen"
        },
        {
          "visible": {
            "id": "mint-info-close"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "open the mint's updates",
      "tap": {
        "id": "mint-info-history"
      },
      "expect": [
        {
          "page": "MintChangesScreen"
        },
        {
          "visible": {
            "id": "mint-changes-populated"
          }
        },
        {
          "visible": {
            "idPrefix": "mint-change-revision-"
          }
        }
      ],
      "withinMs": 15000
    }
  ]
}
