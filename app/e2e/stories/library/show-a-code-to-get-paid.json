{
  "id": "show-a-code-to-get-paid",
  "purpose": "A person opens Receive and shows the code another wallet can scan to pay them, with a button to copy it.",
  "startsFrom": "testnut-mint",
  "steps": [
    {
      "name": "the wallet opens on the test mint",
      "expect": [
        {
          "visible": {
            "id": "wallet-selected-mint:testnut.cashu.space"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Receive",
      "tap": {
        "id": "wallet-receive"
      },
      "expect": [
        {
          "visible": {
            "id": "receive-method-qrDisplay"
          }
        }
      ]
    },
    {
      "name": "show the code",
      "tap": {
        "id": "receive-method-qrDisplay"
      },
      "expect": [
        {
          "page": "ReceiveScreen"
        },
        {
          "visible": {
            "id": "receive-copy"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
