{
  "id": "ask-for-ecash-with-a-payment-request",
  "purpose": "A person asks for 21 sats as ecash and is shown a payment request another wallet can scan or copy.",
  "startsFrom": "testnut-mint",
  "steps": [
    {
      "name": "the wallet opens on the test mint",
      "expect": [
        {
          "visible": {
            "id": "wallet-selected-mint:testnut.cashu.space"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Receive",
      "tap": {
        "id": "wallet-receive"
      },
      "expect": [
        {
          "visible": {
            "id": "receive-method-fixedAmount"
          }
        }
      ]
    },
    {
      "name": "ask for a fixed amount",
      "tap": {
        "id": "receive-method-fixedAmount"
      },
      "expect": [
        {
          "visible": {
            "id": "keypad-key-2"
          }
        }
      ]
    },
    {
      "name": "press 2",
      "tap": {
        "id": "keypad-key-2"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 2 sat"
          }
        }
      ]
    },
    {
      "name": "press 1",
      "tap": {
        "id": "keypad-key-1"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 21 sat"
          }
        }
      ]
    },
    {
      "name": "press Next",
      "tap": {
        "id": "amount-next"
      },
      "expect": [
        {
          "visible": {
            "id": "amount-next-menu-ecash"
          }
        }
      ]
    },
    {
      "name": "choose ecash",
      "tap": {
        "id": "amount-next-menu-ecash"
      },
      "expect": [
        {
          "page": "ReceivePaymentRequestQuoteScreen"
        },
        {
          "visible": {
            "id": "receive-creq-copy"
          }
        },
        {
          "visible": {
            "id": "payment-info-payment-request-data"
          }
        }
      ],
      "withinMs": 15000
    }
  ]
}
