{
  "id": "recover-a-wallet-from-its-mints",
  "purpose": "A person swipes to recover their wallet, it searches each of its mints for their ecash, says it is finished, and they close it.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "open Recover wallet",
      "tap": {
        "id": "settings-recovery-row"
      },
      "expect": [
        {
          "page": "SettingsRecoveryScreen"
        },
        {
          "visible": {
            "id": "slide-to-confirm"
          }
        },
        {
          "visible": {
            "id": "recovery-search-all-toggle"
          }
        },
        {
          "visible": {
            "id": "recovery-cancel"
          }
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "swipe to recover",
      "swipe": {
        "on": {
          "id": "recovery-swipe"
        },
        "direction": "right",
        "distance": 0.85
      },
      "expect": [
        {
          "logged": "recovery.start"
        },
        {
          "logged": "recovery.complete"
        },
        {
          "visible": {
            "id": "recovery-continue"
          }
        }
      ],
      "withinMs": 300000
    },
    {
      "name": "close",
      "tap": {
        "id": "recovery-continue"
      },
      "expect": [
        {
          "gone": {
            "id": "recovery-continue"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
