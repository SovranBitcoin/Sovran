{
  "id": "write-down-the-recovery-words",
  "purpose": "A person starts a backup from Settings, is shown their twelve recovery words, says they have written them down, and is asked to prove it.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "open Profile and keys",
      "tap": {
        "id": "settings-profile-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-backup-row"
          }
        }
      ]
    },
    {
      "name": "start the backup",
      "tap": {
        "id": "settings-backup-row"
      },
      "expect": [
        {
          "page": "BackupIntroScreen"
        },
        {
          "visible": {
            "id": "backup-show-words"
          }
        }
      ]
    },
    {
      "name": "show the words",
      "tap": {
        "id": "backup-show-words"
      },
      "expect": [
        {
          "page": "BackupWordsScreen"
        },
        {
          "visible": {
            "id": "backup-word-1"
          }
        },
        {
          "visible": {
            "id": "backup-word-12"
          }
        },
        {
          "visible": {
            "id": "backup-written"
          }
        }
      ]
    },
    {
      "name": "say they are written down",
      "tap": {
        "id": "backup-written"
      },
      "expect": [
        {
          "gone": {
            "id": "backup-written"
          }
        },
        {
          "visible": {
            "id": "backup-choice-0"
          }
        }
      ]
    }
  ]
}
