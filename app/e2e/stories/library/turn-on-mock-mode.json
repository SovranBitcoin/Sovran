{
  "id": "turn-on-mock-mode",
  "purpose": "A person reveals the developer rows by pressing the app version three times, turns on Mock Mode, and the wallet shows a pretend balance.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.6
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the very end",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.3
      },
      "expect": [
        {
          "visible": {
            "id": "settings-version-row"
          }
        }
      ]
    },
    {
      "name": "press the version, once",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, twice",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "press the version, three times",
      "tap": {
        "id": "settings-version-row"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "scroll to the developer rows",
      "swipe": {
        "on": {
          "id": "settings-terms-row"
        },
        "direction": "up",
        "distance": 0.8
      },
      "expect": [
        {
          "visible": {
            "id": "settings-mock-mode-toggle"
          }
        }
      ]
    },
    {
      "name": "turn on Mock Mode, and let the notice over the header go",
      "tap": {
        "id": "settings-mock-mode-toggle"
      },
      "expect": [
        {
          "visible": {
            "id": "settings-mock-mode-toggle"
          }
        },
        {
          "gone": {
            "label": "Developer mode enabled"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "close Settings",
      "tap": {
        "id": "flow-header-close"
      },
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "visible": {
            "label": "Balance, 247,382 BTC"
          }
        }
      ],
      "withinMs": 10000
    }
  ]
}
