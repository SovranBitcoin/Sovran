{
  "id": "look-at-delete-account-and-leave",
  "purpose": "A person scrolls to Delete account in Settings, opens it, and goes back without deleting anything.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down to the end",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.45
      },
      "expect": [
        {
          "visible": {
            "id": "settings-version-row"
          }
        }
      ]
    },
    {
      "name": "open Delete account",
      "tap": {
        "id": "settings-delete-row"
      },
      "expect": [
        {
          "page": "DeleteScreen"
        },
        {
          "visible": {
            "id": "screen-delete"
          }
        }
      ],
      "withinMs": 10000
    },
    {
      "name": "go back without deleting",
      "tap": {
        "id": "flow-header-back"
      },
      "expect": [
        {
          "gone": {
            "id": "screen-delete"
          }
        },
        {
          "visible": {
            "id": "settings-delete-row"
          }
        }
      ],
      "withinMs": 8000
    }
  ]
}
