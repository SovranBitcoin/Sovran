{
  "id": "open-settings-and-read-the-terms",
  "purpose": "A person opens Settings from the drawer, scrolls to the legal section and reads the Terms again.",
  "startsFrom": "onboarded",
  "steps": [
    {
      "name": "the wallet opens",
      "expect": [
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open the drawer",
      "tap": {
        "id": "header-profile-avatar"
      },
      "expect": [
        {
          "visible": {
            "id": "drawer-menu-settings"
          }
        }
      ]
    },
    {
      "name": "open Settings",
      "tap": {
        "id": "drawer-menu-settings"
      },
      "expect": [
        {
          "page": "SettingsScreen"
        },
        {
          "visible": {
            "id": "settings-profile-row"
          }
        }
      ]
    },
    {
      "name": "scroll down to the legal rows",
      "swipe": {
        "on": {
          "id": "settings-network-row"
        },
        "direction": "up",
        "distance": 0.4
      },
      "expect": [
        {
          "visible": {
            "id": "settings-terms-row"
          }
        }
      ]
    },
    {
      "name": "open the Terms",
      "tap": {
        "id": "settings-terms-row"
      },
      "expect": [
        {
          "visible": {
            "id": "screen-legal-document"
          }
        }
      ]
    }
  ]
}
