{
  "id": "receive-100-sats-on-the-private-mint",
  "purpose": "A person asks for 100 sats over Lightning from the run's own mint, the invoice is paid, and the wallet says the sats were added.",
  "startsFrom": "private-mint",
  "steps": [
    {
      "name": "the wallet opens on the private mint",
      "expect": [
        {
          "visible": {
            "id": "wallet-selected-mint:localhost"
          }
        },
        {
          "visible": {
            "id": "wallet-receive"
          }
        },
        {
          "logged": "splash.gone"
        }
      ],
      "withinMs": 8000
    },
    {
      "name": "open Receive",
      "tap": {
        "id": "wallet-receive"
      },
      "expect": [
        {
          "visible": {
            "id": "receive-method-fixedAmount"
          }
        }
      ]
    },
    {
      "name": "ask for a fixed amount",
      "tap": {
        "id": "receive-method-fixedAmount"
      },
      "expect": [
        {
          "visible": {
            "id": "keypad-key-1"
          }
        },
        {
          "logged": "ui.touch"
        }
      ]
    },
    {
      "name": "press 1",
      "tap": {
        "id": "keypad-key-1"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 1 sat"
          }
        }
      ]
    },
    {
      "name": "press 00",
      "tap": {
        "id": "keypad-key-double-zero"
      },
      "expect": [
        {
          "visible": {
            "label": "Amount 100 sat"
          }
        }
      ]
    },
    {
      "name": "press Next",
      "tap": {
        "id": "amount-next"
      },
      "expect": [
        {
          "visible": {
            "id": "amount-next-menu-lightning"
          }
        }
      ]
    },
    {
      "name": "choose Lightning, and the mint pays at once",
      "tap": {
        "id": "amount-next-menu-lightning"
      },
      "expect": [
        {
          "logged": "coco.operations.mint.quote_created"
        },
        {
          "logged": "hook.payment_status.mint_quote_redeemed"
        },
        {
          "visible": {
            "id": "cta-secondary"
          }
        }
      ],
      "withinMs": 30000
    },
    {
      "name": "put off the backup reminder",
      "tap": {
        "id": "cta-secondary"
      },
      "expect": [
        {
          "gone": {
            "id": "cta-secondary"
          }
        },
        {
          "visible": {
            "id": "lightning-receive-details"
          }
        },
        {
          "visible": {
            "label": "Added to wallet"
          }
        }
      ],
      "withinMs": 8000
    }
  ]
}
