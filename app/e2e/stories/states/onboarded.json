{
  "id": "onboarded",
  "purpose": "A person opens the app for the first time, accepts the Terms and Privacy Policy, starts, and arrives at an empty wallet.",
  "startsFrom": "fresh",
  "steps": [
    {
      "name": "the Terms are shown first",
      "expect": [
        {
          "page": "LegalDocumentScreen"
        },
        {
          "visible": {
            "id": "terms-acceptance"
          }
        }
      ],
      "withinMs": 20000
    },
    {
      "name": "agree to the Terms",
      "tap": {
        "id": "terms-acceptance"
      },
      "expect": [
        {
          "visible": {
            "id": "terms-continue"
          }
        }
      ]
    },
    {
      "name": "continue to Privacy",
      "tap": {
        "id": "terms-continue"
      },
      "expect": [
        {
          "visible": {
            "id": "privacy-acknowledgment"
          }
        },
        {
          "gone": {
            "id": "terms-acceptance"
          }
        }
      ]
    },
    {
      "name": "acknowledge the Privacy Policy",
      "tap": {
        "id": "privacy-acknowledgment"
      },
      "expect": [
        {
          "visible": {
            "id": "privacy-confirm"
          }
        }
      ]
    },
    {
      "name": "confirm and leave the legal pages",
      "tap": {
        "id": "privacy-confirm"
      },
      "expect": [
        {
          "gone": {
            "id": "privacy-confirm"
          }
        },
        {
          "gone": {
            "id": "screen-legal-document"
          }
        }
      ]
    },
    {
      "name": "go on to the profile card",
      "tap": {
        "id": "onboarding-next"
      },
      "expect": [
        {
          "visible": {
            "label": "Carry your profile with you"
          }
        }
      ]
    },
    {
      "name": "go on to the privacy card",
      "tap": {
        "id": "onboarding-next"
      },
      "expect": [
        {
          "visible": {
            "label": "Understand your privacy"
          }
        }
      ]
    },
    {
      "name": "go on to the last card",
      "tap": {
        "id": "onboarding-next"
      },
      "expect": [
        {
          "visible": {
            "label": "Start small"
          }
        },
        {
          "visible": {
            "id": "onboarding-get-started"
          }
        }
      ]
    },
    {
      "name": "get started",
      "tap": {
        "id": "onboarding-get-started"
      },
      "expect": [
        {
          "visible": {
            "id": "wallet-receive"
          }
        },
        {
          "visible": {
            "id": "wallet-send"
          }
        },
        {
          "gone": {
            "id": "screen-onboarding"
          }
        },
        {
          "logged": "gate.app.onboarding_complete"
        }
      ],
      "withinMs": 10000
    }
  ]
}
