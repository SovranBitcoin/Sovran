{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "preserveSymlinks": true,
    // Requires class methods that override a base implementation to be
    // marked with `override`. Catches drift when a base method is
    // renamed or removed — the override silently becomes a fresh method
    // instead of a compile error. Free to enable here (zero current
    // violations).
    "noImplicitOverride": true,
    // Fails the build on a declared-and-never-read local. Dead locals are how
    // a half-removed feature survives review looking intentional — the
    // Add-mint skeleton hold sat unread behind one for months. Free to enable
    // here (zero current violations).
    "noUnusedLocals": true,
    // Same rule for parameters, so a signature can't keep advertising a value
    // the body ignores — `CloseButton(foreground)` and
    // `buildThreadItemsFromResult(eventId, …)` both lied to their callers for
    // months. Positional parameters that genuinely must stay (a `String.replace`
    // whole-match, a middleware `next`) opt out with a leading underscore.
    "noUnusedParameters": true,
    // Fails the build on a `case` that falls through into the next one with a
    // non-empty body. Every deliberate multi-case label (`case 'a': case 'b':`)
    // still compiles; only an accidentally missing `break`/`return` errors.
    // Free to enable here (zero current violations).
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "moduleSuffixes": [".ios", ".android", ""],
    "paths": {
      "@/*": ["./*"],
      "@/shared/*": ["./shared/*"],
      "@/features/*": ["./features/*"],
      "@/sheets/*": ["./shared/lib/popup/sheets/*"],
      "@/navigation/*": ["./navigation/*"],
      "@/config/*": ["./config/*"],
      "@/themes": ["./themes"],
      "~/*": ["src/*"],
      // Pin every `zod`/`neverthrow` import (including those inside the wallet/
      // nostr packages' own source) to a single copy so TypeScript sees one
      // identity — otherwise cross-package types (ZodType, Result) are treated
      // as incompatible. Under the bun workspace the single copy hoists to the
      // root node_modules, so probe app-local first then the hoisted root.
      // Mirrors the Metro resolver pinning so type-check and runtime agree.
      "zod": ["./node_modules/zod", "../node_modules/zod"],
      "zod/*": ["./node_modules/zod/*", "../node_modules/zod/*"],
      "neverthrow": ["./node_modules/neverthrow", "../node_modules/neverthrow"],
      "neverthrow/*": ["./node_modules/neverthrow/*", "../node_modules/neverthrow/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
