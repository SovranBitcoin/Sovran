{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_NO_DEV_CLIENT": "1"
      },
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {},
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "env": {},
      "android": {
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "autoIncrement": true
    },
    "zapstore": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "zapstore"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.sovranbitcoin",
        "track": "internal"
      },
      "ios": {
        "appleId": "business@sovranbitcoin.com",
        "ascAppId": "6499554529",
        "appleTeamId": "2ZTL7KLN2V"
      }
    }
  }
}
