diff --git a/packages/core/infra/handlers/send/exactSubset.ts b/packages/core/infra/handlers/send/exactSubset.ts
new file mode 100644
index 00000000..ba57cf15
--- /dev/null
+++ b/packages/core/infra/handlers/send/exactSubset.ts
@@ -0,0 +1,51 @@
+import { Amount, type Proof } from '@cashu/cashu-ts';
+
+/** Largest exact-match target searched by dynamic programming; larger sums rely on greedy. */
+const EXACT_SEARCH_LIMIT = 2_000_000;
+
+/**
+ * An exact subset of `available` summing to `amount`, or null when none exists. The randomized
+ * selector can miss an exact match; a wallet that promised the user an exact amount must not
+ * depend on chance. Largest-first is exact for power-of-two denominations; other denominations
+ * get a subset-sum search up to {@link EXACT_SEARCH_LIMIT}.
+ */
+export function selectExactSubset(available: readonly Proof[], amount: Amount): Proof[] | null {
+  const sorted = [...available].sort((a, b) => {
+    const left = Amount.from(a.amount);
+    const right = Amount.from(b.amount);
+    return left.equals(right) ? 0 : left.greaterThan(right) ? -1 : 1;
+  });
+  const greedy: Proof[] = [];
+  let remaining = amount;
+  for (const proof of sorted) {
+    if (remaining.isZero()) break;
+    const value = Amount.from(proof.amount);
+    if (value.greaterThan(remaining)) continue;
+    greedy.push(proof);
+    remaining = remaining.subtract(value);
+  }
+  if (remaining.isZero()) return greedy;
+
+  const target = Number(amount.toString());
+  if (!Number.isSafeInteger(target) || target > EXACT_SEARCH_LIMIT) return null;
+  // from[s] is the index of the proof that first reached sum s; a reached sum's predecessor was
+  // always reached by an earlier proof, so walking back never reuses one.
+  const from = new Int32Array(target + 1).fill(-1);
+  const values = sorted.map((proof) => Number(Amount.from(proof.amount).toString()));
+  from[0] = values.length;
+  for (let index = 0; index < values.length && from[target] === -1; index++) {
+    const value = values[index]!;
+    if (value <= 0 || value > target) continue;
+    for (let sum = target; sum >= value; sum--) {
+      if (from[sum] === -1 && from[sum - value] !== -1) from[sum] = index;
+    }
+  }
+  if (from[target] === -1) return null;
+  const selected: Proof[] = [];
+  for (let sum = target; sum > 0; ) {
+    const index = from[sum]!;
+    selected.push(sorted[index]!);
+    sum -= values[index]!;
+  }
+  return selected;
+}
