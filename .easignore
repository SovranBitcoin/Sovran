# EAS archive ignore — workspace-root copy.
# Used when EAS archives from the bun-workspace root (app/ is a workspace member,
# and wallet/ + nostr/ must be included in the build). Paths are root-relative.
# A second, app-relative copy lives at app/.easignore for the case where EAS
# treats app/ as the archive root. Keep the two in sync.
# NOTE: verify which root EAS actually archives from on the first build.

# Exclude coco submodule — app uses npm packages (coco-cashu-core, etc.), not local source.
# The submodule causes git clone exit 128 during EAS tarball creation.
app/coco/

# E2E run artifacts (screenshots/state sidecars) — gigabytes, never needed in a build.
app/e2e/artifacts/

# Runtime logs picked up by log-doctor — not build inputs.
app/log.txt
app/wda.log

# Standard exclusions (match any depth)
node_modules/
.expo/
dist/
!app/vendor/**/dist/
!app/vendor/**/dist/**
web-build/
*.orig.*
*.jks
*.keystore
credentials/
credentials.json
*service-account*.json
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
.env
.env.*
!.env.example
.env.local
*.tsbuildinfo
expo-env.d.ts
.vscode
/app/android/
/app/ios/
app/targets/widget/generated.entitlements
app/targets/widget/Assets.xcassets/AppIcon.appiconset/
app/targets/widget/Assets.xcassets/$*.colorset/
