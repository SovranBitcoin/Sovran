---
import Page from '../layouts/Page.astro';
import Downloads from '../components/Downloads.astro';
import { siteCopy } from '../../../copy/src/site';
const { hero, proof } = siteCopy;
// Exported by scripts/hero-image.mjs, cropped above the capture's tab bar.
const phone = (format: string) => [600, 900].map(width => `/hero/wallet-${width}.${format} ${width}w`).join(', ');
const sizes = '(min-width: 1100px) 388px, (min-width: 424px) 312px, 74vw';
---
<Page>
  <section id="hero" class="hero" data-scene="hero" aria-labelledby="hero-title">
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero-text">{hero.text}</p>
        <div id="download" class="hero-download"><Downloads compact /></div>
        <p class="hero-risk">{siteCopy.risk} <a href="/terms">Read the terms</a></p>
      </div>
      <div class="hero-phone">
        <div class="device">
          <picture>
            <source type="image/avif" srcset={phone('avif')} sizes={sizes} />
            <source type="image/webp" srcset={phone('webp')} sizes={sizes} />
            <img src="/hero/wallet-600.webp" width="600" height="1050" alt={hero.alt} fetchpriority="high" decoding="async" />
          </picture>
        </div>
      </div>
    </div>
  </section>
  <section id="proof" class="proof" aria-label="Source and support">
    <p class="wrap"><a href={proof.source.href} rel="noreferrer">{proof.source.label}</a><span aria-hidden="true"> · </span><a href={proof.grant.href} rel="noreferrer">{proof.grant.label}</a></p>
  </section>
</Page>
