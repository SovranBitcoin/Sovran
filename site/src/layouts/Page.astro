---
import '../styles/site.css';
import { siteCopy } from '../../../copy/src/site';
import { websiteAssetStatus } from '../../scripts/website-assets.mjs';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = siteCopy.title, description = siteCopy.description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const source = 'https://github.com/SovranBitcoin/Sovran';
const header = [['/releases', 'Releases'], ['/roadmap', 'Roadmap'], ['/download', 'Download']];
const footer = [['/download', 'Download'], ['/releases', 'Releases'], ['/roadmap', 'Roadmap'], ['/faq', 'FAQ'], ['/terms', 'Terms'], ['/privacy', 'Privacy']];
// Never advertise an old scene export after the screenshots or composition change.
let socialImage;
try {
  const status = await websiteAssetStatus(import.meta.env.SOVRAN_REPO_ROOT);
  socialImage = status.outputs.find(output => output.output === 'social/og.png' &&
    (output.current || (!status.fingerprint && output.renderCurrent)));
} catch { /* Missing or invalid evidence must never advertise an old export. */ }
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(path, 'https://sovran.money')} />
    <link rel="preload" href="/fonts/MonaSans/MonaSans-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MonaSans/MonaSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, 'https://sovran.money')} />
    <link rel="icon" href="/sovran-mark.svg" type="image/svg+xml" />
    {socialImage && <><meta property="og:image" content="https://sovran.money/social/og.png" /><meta property="og:image:width" content={String(socialImage.recipe.width)} /><meta property="og:image:height" content={String(socialImage.recipe.height)} /><meta property="og:image:alt" content={socialImage.recipe.title} /><meta name="twitter:card" content="summary_large_image" /></>}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Sovran home"><img src="/sovran-mark.svg" alt="" width="20" height="20" />SOVRAN</a>
      <nav aria-label="Main navigation">
        {header.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <nav aria-label="Footer navigation">
          {footer.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
          <a href={source} rel="noreferrer">Source code</a>
        </nav>
        <small>&copy; {new Date().getFullYear()} SOVRAN LTD · <a href={`${source}/blob/main/LICENSE`}>MPL-2.0</a> · <a href="/licenses/README.txt">Third-party notices</a></small>
      </div>
    </footer>
  </body>
</html>
