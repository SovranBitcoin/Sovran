{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreIssues": {
    "**/*.android.{ts,tsx}": ["files"],
    "**/*.ios.{ts,tsx}": ["files"],
    "**/*.liquid.{ts,tsx}": ["files"],
    "**/*.blur.{ts,tsx}": ["files"],
    "app/assets/icons/index.tsx": ["exports"],
    "app/codereview/log-doctor/test-dsl/cashu-decode.ts": ["exports"],
    "app/features/feed/data/recentPeopleProfiles.ts": ["exports"],
    "app/shared/lib/e2e/stateMirror.ts": ["exports"],
    "app/shared/lib/popup/popups/sendMemoSheet.tsx": ["exports"]
  },
  "workspaces": {
    "app": {
      "entry": [
        "shim.js",
        "polyfills.js",
        "metro.config.js",
        "app/**/*.{ts,tsx}",
        "plugins/*.js",
        "scripts/*.{js,ts}",
        "e2e/viewer/server.ts",
        "e2e/viewer/src/main.ts",
        "e2e/audit/fresh-matrix-cli.ts"
      ],
      "project": ["**/*.{ts,tsx,js,jsx}"],
      "ignore": ["modules/**", "targets/**"],
      "ignoreDependencies": [
        "^@iconify-json/",
        "buffer",
        "process",
        "expo-screen-corner-radius",
        "cashu-kym",
        "@monicon/metro",
        "metro-minify-terser",
        "number-flow-react-native",
        "patch-package",
        "react-native-fast-squircle",
        "@noble/curves"
      ],
      "ignoreBinaries": ["claude", "eas", "gh", "tsx"]
    },
    "wallet": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@cashu/coco-core"]
    },
    "nostr": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "docs": {
      "project": [".vitepress/**/*.{ts,mts}"]
    }
  },
  "ignoreBinaries": ["knip"]
}
