{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreIssues": {
    "**/*.android.{ts,tsx}": [
      "files"
    ],
    "**/*.ios.{ts,tsx}": [
      "files"
    ],
    "**/*.liquid.{ts,tsx}": [
      "files"
    ],
    "**/*.blur.{ts,tsx}": [
      "files"
    ],
    "app/codereview/**": [
      "exports",
      "types"
    ],
    "app/features/composer/**": [
      "exports",
      "types"
    ],
    "app/features/feed/**": [
      "exports",
      "types"
    ],
    "app/shared/lib/nostr/media/**": [
      "exports",
      "types"
    ],
    "app/shared/lib/nostr/outbox/**": [
      "types"
    ],
    "app/shared/lib/nostr/nip11.ts": [
      "exports",
      "types"
    ],
    "app/shared/lib/nostr/njump.ts": [
      "types"
    ],
    "app/shared/lib/nostr/nostrTierConfig.ts": [
      "exports",
      "types"
    ],
    "app/shared/lib/nostr/useEntityCache.ts": [
      "exports",
      "types"
    ],
    "app/features/transactions/components/MonthSelector.tsx": [
      "types"
    ],
    "app/features/camera/**": [
      "files",
      "types"
    ],
    "app/features/mint/**": [
      "exports",
      "types"
    ],
    "app/features/settings/**": [
      "exports"
    ],
    "app/features/transactions/**": [
      "exports"
    ],
    "app/features/user/**": [
      "exports"
    ],
    "app/features/wallet/**": [
      "exports",
      "types"
    ],
    "app/assets/icons/**": [
      "exports"
    ],
    "app/shared/blocks/PullToAiRefreshControl.tsx": [
      "exports"
    ],
    "app/shared/blocks/status/**": [
      "exports",
      "types",
      "duplicates"
    ],
    "app/shared/lib/date.ts": [
      "types"
    ],
    "app/shared/lib/nav/profileRoutes.ts": [
      "types"
    ],
    "app/shared/lib/popup/popups/index.ts": [
      "types"
    ],
    "app/shared/lib/wallpaperStorage.ts": [
      "exports"
    ],
    "app/shared/styles/tokens.ts": [
      "exports",
      "types"
    ],
    "app/shared/ui/capability/index.tsx": [
      "exports",
      "types"
    ],
    "app/shared/ui/composed/GlassSearchBar/**": [
      "files",
      "types"
    ],
    "app/shared/ui/composed/QRButton/**": [
      "files",
      "types"
    ],
    "app/shared/ui/primitives/SelectableCheck/index.tsx": [
      "types"
    ],
    "app/shared/lib/popup/**": [
      "exports"
    ],
    "wallet/**": [
      "exports",
      "types",
      "files"
    ],
    "nostr/**": [
      "exports",
      "types",
      "files"
    ]
  },
  "workspaces": {
    "app": {
      "entry": [
        "shim.js",
        "polyfills.js",
        "metro.config.js",
        "app/**/*.{ts,tsx}",
        "plugins/withLowerPodDeploymentTarget.js",
        "plugins/withNeutralAndroidTextColors.js",
        "scripts/*.{js,ts}"
      ],
      "project": [
        "**/*.{ts,tsx,js,jsx}"
      ],
      "ignore": [
        ".monicon/**",
        "modules/**",
        "targets/**"
      ],
      "ignoreDependencies": [
        "^@iconify-json/",
        "buffer",
        "process",
        "@expo/metro-config",
        "expo-screen-corner-radius",
        "cashu-kym",
        "@monicon/metro",
        "metro-minify-terser",
        "number-flow-react-native",
        "patch-package",
        "react-native-fast-squircle"
      ],
      "ignoreBinaries": [
        "claude",
        "eas",
        "gh",
        "maestro",
        "tsx"
      ]
    },
    "wallet": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "nostr": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "docs": {
      "project": [
        ".vitepress/**/*.{ts,mts}"
      ]
    }
  },
  "ignoreBinaries": [
    "knip"
  ]
}
