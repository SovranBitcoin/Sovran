{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["shim.js", "polyfills.js", "app/**/*.{ts,tsx}", "scripts/*.{js,ts}", "plugins/**/*.js"],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    ".agents/**",
    ".cursor/**",
    ".monicon/**",
    "dist/**",
    "ios/**",
    "targets/**",
    "coco/**",
    "eNuts/**",
    "node_modules/**"
  ],
  "ignoreDependencies": [
    "buffer",
    "process",
    "cashu-kym",
    "@monicon/metro",
    "@monicon/core",
    "number-flow-react-native",
    "@expo/config-plugins"
  ],
  "ignoreBinaries": ["eas", "maestro"],
  "ignoreIssues": {
    "components/blocks/nostr/**": ["exports", "types", "duplicates"],
    "components/blocks/UserFeed.tsx": ["exports", "types"],
    "features/wallet/lib/walletHeader.ts": ["exports"],
    "helper/nfc/**": ["exports", "types"],
    "helper/nfc.ts": ["exports", "types"],
    "stores/nostrSocialStore.ts": ["exports"],
    "components/blocks/rebalance/demoRunner.ts": ["files"],
    "components/blocks/DebugBalancePanel.tsx": ["files"],
    "components/blocks/DevPopupPanel.tsx": ["files"],
    "helper/popup/popups.ts": ["exports"],
    "helper/secureStorage.ts": ["exports"]
  }
}
