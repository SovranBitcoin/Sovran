{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["shim.js", "polyfills.js", "app/**/*.{ts,tsx}", "scripts/*.{js,ts}", "plugins/**/*.js"],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    ".agents/**",
    ".cursor/**",
    ".monicon/**",
    "dist/**",
    "ios/**",
    "targets/**",
    "coco/**",
    "eNuts/**",
    "node_modules/**"
  ],
  "ignoreDependencies": [
    "buffer",
    "process",
    "cashu-kym",
    "@monicon/metro",
    "@monicon/core",
    "number-flow-react-native",
    "@expo/config-plugins"
  ],
  "ignoreBinaries": ["eas", "maestro"],
  "ignoreIssues": {
    "features/feed/components/nostr/**": ["exports", "types", "duplicates"],
    "features/feed/components/UserFeed.tsx": ["exports", "types"],
    "features/wallet/lib/walletHeader.ts": ["exports"],
    "shared/lib/nfc/**": ["exports", "types"],
    "shared/stores/profile/nostrSocialStore.ts": ["exports"],
    "features/mint/components/rebalance/demoRunner.ts": ["files"],
    "shared/lib/popup/popups.ts": ["exports"],
    "shared/lib/nostr/secureStorage.ts": ["exports"]
  }
}
