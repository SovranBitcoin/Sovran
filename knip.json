{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "shim.js",
    "polyfills.js",
    "metro.config.js",
    "app/**/*.{ts,tsx}",
    "plugins/withLowerPodDeploymentTarget.js",
    "scripts/*.{js,ts}"
  ],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    ".agents/**",
    ".monicon/**",
    "modules/**",
    "targets/**"
  ],
  "ignoreDependencies": [
    "^@iconify-json/",
    "buffer",
    "process",
    "@expo/metro-config",
    "@sovranbitcoin/schemas",
    "cashu-kym",
    "@internet-privacy/marmot-ts",
    "bitchat-module",
    "coco-cashu-plugin-p2pk-import",
    "liquid-glass-text",
    "@monicon/metro",
    "metro-minify-terser",
    "number-flow-react-native",
    "nutpatch",
    "patch-package"
  ],
  "ignoreBinaries": ["claude", "eas", "maestro", "tsx"],
  "ignoreIssues": {
    "**/*.android.{ts,tsx}": ["files"],
    "**/*.liquid.{ts,tsx}": ["files"],
    "codereview/**": ["exports", "types"],
    "features/feed/**": ["exports", "types"],
    "features/transactions/components/MonthSelector.tsx": ["types"],
    "features/camera/**": ["files", "types"],
    "features/mint/**": ["exports", "types"],
    "features/settings/**": ["exports"],
    "features/transactions/**": ["exports"],
    "features/user/**": ["exports"],
    "features/wallet/**": ["exports", "types"],
    "assets/icons/**": ["exports"],
    "shared/blocks/PullToAiRefreshControl.tsx": ["exports"],
    "shared/blocks/status/**": ["exports", "types", "duplicates"],
    "shared/lib/date.ts": ["types"],
    "shared/lib/nav/profileRoutes.ts": ["types"],
    "shared/lib/popup/popups/index.ts": ["types"],
    "shared/lib/wallpaperStorage.ts": ["exports"],
    "shared/styles/tokens.ts": ["exports", "types"],
    "shared/ui/capability/index.tsx": ["exports", "types"],
    "shared/ui/composed/GlassSearchBar/**": ["files", "types"],
    "shared/ui/composed/QRButton/**": ["files", "types"],
    "shared/ui/primitives/SelectableCheck/index.tsx": ["types"],
    "shared/lib/popup/**": ["exports"],
    "coco-cashu-plugin-p2pk-import/**": ["files", "exports", "types", "unlisted"]
  }
}
