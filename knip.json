{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["shim.js", "polyfills.js", "app/**/*.{ts,tsx}", "scripts/*.js"],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    ".agents/**",
    ".cursor/**",
    ".monicon/**",
    "dist/**",
    "ios/**",
    "coco/**",
    "node_modules/**"
  ],
  "ignoreDependencies": ["buffer", "process", "cashu-kym", "@babel/core", "@monicon/metro"],
  "ignoreBinaries": ["eas", "maestro"]
}
