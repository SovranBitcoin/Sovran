{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.js",
    "shim.js",
    "polyfills.js",
    "app/**/*.{ts,tsx}",
    "scripts/*.js",
    "metro.config.js",
    "babel.config.js",
    "app.config.js"
  ],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignore": [".cursor/**", "dist/**", "ios/**", "coco/**", "node_modules/**"],
  "ignoreDependencies": ["buffer", "process", "cashu-kym", "@babel/core"],
  "ignoreBinaries": ["eas", "maestro"]
}
